            </main>
        </div>
    </div>

    <footer class="mt-4">
        <div class="container">
            <small class="text-muted">&copy; 2025 Bookaholic</small>
        </div>
    </footer>

    <!-- Global toast container (rendered for all admin pages) -->
    <div id="orderNotifications" aria-live="polite" aria-atomic="true"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SignalR client + global admin connection (runs on every admin page) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js" crossorigin="anonymous"></script>
    <script>
        (function () {
            try {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/orderHub")
                    .withAutomaticReconnect()
                    .build();

                connection.on("NewOrder", function (data) {
                    const container = document.getElementById("orderNotifications");
                    if (!container) return;

                    const id = "notif-" + Date.now();
                    const div = document.createElement("div");
                    div.id = id;
                    div.className = "toast align-items-center text-bg-info border-0 show";
                    div.setAttribute("role", "alert");
                    div.setAttribute("aria-live", "assertive");
                    div.setAttribute("aria-atomic", "true");
                    div.innerHTML = `
                        <div class="d-flex">
                            <div class="toast-body">
                                New order <strong>#${data.orderId}</strong><br/>
                                ${data.customer} — PKR ${Number(data.total).toLocaleString()}
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" aria-label="Close"></button>
                        </div>`;

                    container.prepend(div);
                    const closeBtn = div.querySelector(".btn-close");
                    if (closeBtn) closeBtn.addEventListener("click", () => div.remove());

                    // auto remove after 12s
                    setTimeout(() => {
                        if (div.parentNode) div.parentNode.removeChild(div);
                    }, 12000);
                });

                connection.start().catch(function (err) {
                    console.error("SignalR connection error:", err && err.toString ? err.toString() : err);
                });
            } catch (ex) {
                console.error("SignalR initialization failed:", ex);
            }
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>