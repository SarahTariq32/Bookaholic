@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bookaholic</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        .subcategory-list {
            display: none;
            padding-left: 0.75rem;
            margin-top: 0.5rem;
        }

        .sidebar-list li.open > .subcategory-list {
            display: block;
        }

        .category-toggle {
            background: none;
            border: none;
            color: inherit;
            padding: 0;
            font: inherit;
            text-align: left;
            width: 100%;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <header>

        <div class="text-center py-1" style="background-color:#A26769; color:#FAF9F6; font-size:0.85rem;">
            Free delivery on orders above 2,000 PKR
        </div>

        <nav class="navbar navbar-expand-lg" style="background-color:#2C2E43;">
            <div class="container-fluid d-flex justify-content-between align-items-center">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index" style="font-family: 'Cinzel', serif; color: #C7A86B; font-weight:700; font-size:2rem;">
                    Bookaholic
                </a>

                <button class="btn d-lg-inline text-light me-2" id="categoriesBtn">
                    Categories
                </button>

                <button class="btn d-lg-none text-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <i class="bi bi-list" style="font-size:1.5rem;"></i>
                </button>

                <div class="collapse navbar-collapse justify-content-end" id="navbarContent">
                    <form id="searchForm" class="d-flex mx-3 flex-grow-1">
                        <input id="searchInput"
                               class="form-control form-control-sm flex-grow-1"
                               type="search"
                               placeholder="Search books..."
                               aria-label="Search" />

                        <button id="searchBtn"
                                class="btn ms-2"
                                type="submit"
                                style="background-color:#C7A86B; color:#2C2E43;">
                            Search
                        </button>
                    </form>

                    <ul class="navbar-nav mb-2 mb-lg-0 d-flex align-items-center">

                        <li class="nav-item">
                            <a class="nav-link text-light nav-hover px-3" asp-controller="Home" asp-action="Contact">Contact Us</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light nav-hover px-3" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart"></i> Cart
                            </a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.HasClaim("Role", "Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-warning fw-bold px-3"
                                       asp-controller="Admin"
                                       asp-action="Dashboard">
                                        Admin Dashboard
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <form asp-area="Identity"
                                      asp-page="/Account/Logout"
                                      method="post"
                                      class="d-inline">
                                    <button type="submit" class="nav-link text-light bg-transparent border-0 px-3">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light px-3"
                                   asp-area="Identity"
                                   asp-page="/Account/Register">
                                    Register
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-light px-3"
                                   asp-area="Identity"
                                   asp-page="/Account/Login">
                                    Login
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
        <div id="categoriesSidebar" class="sidebar p-3" style="background:#1F2937;">
            <button class="closebtn text-light" id="closeSidebar" style="font-size:1.4rem; background:none; border:none;">&times;</button>
            <h4 class="text-light mt-3 ps-1">Categories</h4>

            <style>
                #categoriesSidebar .btn-toggle {
                    background: none;
                    border: none;
                    color: #FAF9F6;
                    text-align: left;
                    width: 100%;
                    padding: .35rem .5rem;
                    font-weight: 600;
                }

                    #categoriesSidebar .btn-toggle:focus {
                        outline: none;
                        box-shadow: none;
                    }

                #categoriesSidebar .subcategory a {
                    color: #FAF9F6;
                    display: block;
                    padding: .35rem .75rem;
                    text-decoration: none;
                    border-radius: 6px;
                }

                    #categoriesSidebar .subcategory a:hover {
                        background: rgba(199,168,107,0.12);
                        color: #C7A86B;
                        text-decoration: none;
                    }
            </style>

            <ul class="list-unstyled mb-0 mt-2">
                <li class="mb-2">
                    <button class="btn-toggle" data-bs-toggle="collapse" data-bs-target="#fictionCollapse" aria-expanded="true" aria-controls="fictionCollapse">
                        Fiction
                    </button>
                    <div class="collapse show subcategory" id="fictionCollapse">
