
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bookaholic</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body>

    <header>

        <div class="text-center py-1" style="background-color:#A26769; color:#FAF9F6; font-size:0.85rem;">
            Free delivery on orders above 2,000 PKR
        </div>

        <nav class="navbar navbar-expand-lg" style="background-color:#2C2E43;">
            <div class="container-fluid d-flex justify-content-between align-items-center">

               
                <a class="navbar-brand" href="#" style="font-family: 'Cinzel', serif; color: #C7A86B; font-weight:700; font-size:2rem;">
                    Bookaholic
                </a>

                <button class="btn d-lg-inline text-light me-2" id="categoriesBtn">
                    Categories
                </button>

                <button class="btn d-lg-none text-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <i class="bi bi-list" style="font-size:1.5rem;"></i>
                </button>

                <div class="collapse navbar-collapse justify-content-end" id="navbarContent">
                    @* <form class="d-flex mx-3 flex-grow-1" role="search">
                        <input class="form-control form-control-sm flex-grow-1" type="search" placeholder="Search books..." aria-label="Search">
                        <button class="btn ms-2" type="submit" style="background-color:#C7A86B; color:#2C2E43;">Search</button>
                    </form> *@
                    <form id="searchForm" class="d-flex mx-3 flex-grow-1">
                        <input id="searchInput"
                               class="form-control form-control-sm flex-grow-1"
                               type="search"
                               placeholder="Search books..."
                               aria-label="Search" />

                        <button id="searchBtn"
                                class="btn ms-2"
                                type="submit"
                                style="background-color:#C7A86B; color:#2C2E43;">
                            Search
                        </button>
                    </form>


                    <ul class="navbar-nav mb-2 mb-lg-0 d-flex align-items-center">
                        <li class="nav-item"><a class="nav-link text-light nav-hover px-3" href="#">Contact Us</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Login">Login</a></li>
                        <li class="nav-item"><a class="nav-link text-light nav-hover px-3" href="#"><i class="bi bi-cart"></i> Cart</a></li>
                    </ul>
                </div>
            </div>
        </nav>


        <div id="categoriesSidebar" class="sidebar">
            <button class="closebtn" id="closeSidebar">&times;</button>
            <h4 class="text-light mt-4 ps-3">Categories</h4>
            <ul class="sidebar-list">
                <li>
                    <a href="#" class="category-link">Fiction</a>
                    <ul class="subcategory-list">
                        <li><a href="#">Romance</a></li>
                        <li><a href="#">Fantasy Fiction</a></li>
                        <li><a href="#">Adventure Fiction</a></li>
                        <li><a href="#">Historical Fiction</a></li>
                        <li><a href="#">Horror</a></li>
                        <li><a href="#">Humor</a></li>
                        <li><a href="#">Mystery</a></li>
                        <li><a href="#">Thriller</a></li>
                        <li><a href="#">Young Adult</a></li>
                    </ul>
                </li>
                <li>
                    <a href="#" class="category-link">Non-Fiction</a>
                    <ul class="subcategory-list">
                        <li><a href="#">Autobiography</a></li>
                        <li><a href="#">Biography</a></li>
                        <li><a href="#">Business</a></li>
                        <li><a href="#">Cultural</a></li>
                        <li><a href="#">Economic</a></li>
                        <li><a href="#">Education</a></li>
                        <li><a href="#">Entrepreneurship</a></li>
                        <li><a href="#">Finance</a></li>
                        <li><a href="#">History</a></li>
                        <li><a href="#">Inspirational</a></li>
                        <li><a href="#">Leadership</a></li>
                        <li><a href="#">Management</a></li>
                    </ul>
                </li>
                <li>
                    <a href="#" class="category-link">Islamic</a>
                    <ul class="subcategory-list">
                        <li><a href="#">Islamic Books</a></li>
                    </ul>
                </li>
                <li>
                    <a href="#" class="category-link">Children</a>
                    <ul class="subcategory-list">
                        <li><a href="#">Kids Stories</a></li>
                        <li><a href="#">Educational</a></li>
                    </ul>
                </li>
                <li>
                    <a href="#" class="category-link">Urdu</a>
                    <ul class="subcategory-list">
                        <li><a href="#">Urdu Books</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </header>

    <div class="container-fluid p-0 main-content">
        <div id="searchResults" class="container mt-3"></div>

        @RenderBody()
    </div>

    <footer>
        <div class="footer-container">
            <div class="footer-about">
                <h4>Bookaholic</h4>
                <p>"So many books, so little time 📚"</p>
            </div>
            <div class="footer-contact">
                <h4>Contact Us</h4>
                <p>Email: <a href="mailto:bookaholic@gmail.com">bookaholic@gmail.com</a></p>
                <p>Phone: +92 300 1234567</p>
            </div>
            <div class="footer-links">
                <h4>Quick Links</h4>
                <ul>
                    <li><a href="/Books/Fantasy">Fantasy</a></li>
                    <li><a href="/Books/Thriller">Thriller</a></li>
                    <li><a href="/Books/Islamic">Islamic</a></li>
                    <li><a href="/Books/Horror">Horror</a></li>
                    <li><a href="/Books/SelfHelp">Self Help</a></li>
                    <li><a href="/Books/Urdu">Urdu</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            &copy; 2025 Bookaholic. Happy reading! 💛
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
       
        document.getElementById("categoriesBtn").addEventListener("click", function(){
            document.getElementById("categoriesSidebar").style.width = "250px";
        });

        
        document.getElementById("closeSidebar").addEventListener("click", function(){
            document.getElementById("categoriesSidebar").style.width = "0";
            document.querySelectorAll(".category-link").forEach(link => link.classList.remove("active"));
        });

        
        document.querySelectorAll(".category-link").forEach(link => {
            link.addEventListener("click", function(e){
                e.preventDefault();
                document.querySelectorAll(".category-link").forEach(other => {
                    if(other !== this) other.classList.remove("active");
                });
                this.classList.toggle("active");
            });
        });
    </script>
    <script>
        $(document).on("submit", "#searchForm", function (e) {
            e.preventDefault();

            let query = $("#searchInput").val().trim();

            if (query.length === 0) {
                $("#searchResults").hide().html("");
                $("#indexPage").show();
                return;
            }

            $.ajax({
                url: "/Home/Search",
                type: "GET",
                data: { query: query },

                success: function (data) {
                    $("#indexPage").hide();

                    $("#searchResults").show().html(data);
                },

                error: function () {
                    $("#indexPage").hide();

                    $("#searchResults").show().html(
                        "<div class='alert alert-danger text-center mt-3'>Error loading search results.</div>"
                    );
                }
            });
        });
    </script>



    @RenderSection("Scripts", required: false)

</body>
</html>
