                /* Active (expanded) top-level style */
                .sidebar a.category-link.active {
                    background-color: #C7A86B;
                    color: #2C2E43;
                }

        /* Subcategories are indented and visible only when parent is active */
        .subcategory-list {
            display: none;
            padding-left: 22px;
            margin-bottom: .6rem;
        }

            .subcategory-list li a {
                display: block;
                padding: 8px 16px;
                color: #FAF9F6;
                text-decoration: none;
                border-radius: 6px;
                transition: background .12s, color .12s;
            }

                .subcategory-list li a:hover {
                    background: #C7A86B;
                    color: #2C2E43;
                }
        /* show sublist when top-level has .active */
        .sidebar a.category-link.active + .subcategory-list {
            display: block;
        }

        /* Ensure subcategories visually look nested (not flush under parent) */
        .subcategory-list {
            margin-left: 8px;
        }

        /* Main content adjustments to avoid gap */
        .main-content {
            padding-top: 0;
        }

        /* Small screens: make sidebar full height and easier to close */
        

        .sidebar.open {
            width: 86%;
            max-width: 360px;
        }

        }
    </style>
</head>
