                padding: 0;
                margin: 0;
            }

                .sidebar .sidebar-list li {
                    padding-left: 0;
                }

            /* Top-level category links (non-navigating toggles) */
            .sidebar a.category-link {
                display: block;
                padding: 14px 22px;
                font-size: 1.05rem;
                font-weight: 600;
                color: #FAF9F6;
                text-decoration: none;
                transition: background .15s, color .15s;
            }

                .sidebar a.category-link:hover {
