        /* Sidebar (matching your reference UI) */
        .sidebar {
            height: 100%;
            width: 0;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #2C2E43;
            overflow-x: hidden;
            transition: width 0.28s ease;
            z-index: 1200;
