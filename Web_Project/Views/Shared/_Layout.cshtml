@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bookaholic</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    @RenderSection("Styles", required: false)

    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
        }

        header {
            z-index: 1000;
            position: relative;
        }

        .navbar, header, .sales-bar {
            border-bottom: 0 !important;
            box-shadow: none !important;
        }

        .top-info {
            background: #A26769;
            color: #FAF9F6;
            font-size: .85rem;
            line-height: 1.8;
            text-align: center;
        }

        .site-navbar {
            background: #2C2E43;
            border-bottom: 0;
        }

            .site-navbar .navbar-brand {
                font-family: 'Cinzel', serif;
                color: #C7A86B;
                font-weight: 700;
                font-size: 2rem;
            }

            .site-navbar .nav-link {
                color: #FAF9F6;
            }

                .site-navbar .nav-link:hover {
                    color: #C7A86B;
                }

        .sidebar {
            height: 100%;
            width: 0;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #2C2E43;
            overflow-x: hidden;
            transition: width 0.28s ease;
            z-index: 1200;
            padding-top: 72px; 
            box-shadow: 4px 0 18px rgba(0,0,0,0.35);
        }

            .sidebar.open {
                width: 280px;
            }

            .sidebar .closebtn {
                position: absolute;
                top: 12px;
                right: 14px;
                font-size: 28px;
                color: #fff;
                background: none;
                border: none;
                cursor: pointer;
            }

            .sidebar .sidebar-list {
                list-style: none;
                padding: 0;
                margin: 0;
            }

                .sidebar .sidebar-list li {
                    padding-left: 0;
                }

            .sidebar a.category-link {
                display: block;
                padding: 14px 22px;
                font-size: 1.05rem;
                font-weight: 600;
                color: #FAF9F6;
                text-decoration: none;
                transition: background .15s, color .15s;
            }

                .sidebar a.category-link:hover {
                    background-color: #C7A86B;
                    color: #2C2E43;
                }

                .sidebar a.category-link.active {
                    background-color: #C7A86B;
                    color: #2C2E43;
                }

        .subcategory-list {
            display: none;
            padding-left: 22px;
            margin-bottom: .6rem;
        }

            .subcategory-list li a {
                display: block;
                padding: 8px 16px;
                color: #FAF9F6;
                text-decoration: none;
                border-radius: 6px;
                transition: background .12s, color .12s;
            }

                .subcategory-list li a:hover {
                    background: #C7A86B;
                    color: #2C2E43;
                }
        .sidebar a.category-link.active + .subcategory-list {
            display: block;
        }
    .subcategory-list {
            margin-left: 8px;
        }
      .main-content {
            padding-top: 0;
        }

        .sidebar.open {
            width: 86%;
            max-width: 360px;
        }

        }
    </style>
</head>
<body>
    <header>
        @await Component.InvokeAsync("SalesBar")

        <nav class="navbar navbar-expand-lg site-navbar">
            <div class="container-fluid d-flex justify-content-between align-items-center">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Bookaholic</a>

                <button class="btn d-lg-inline text-light me-2" id="categoriesBtn" aria-controls="categoriesSidebar" aria-expanded="false" aria-label="Open categories">
                    Categories
                </button>

                <button class="btn d-lg-none text-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent">
                    <i class="bi bi-list" style="font-size:1.5rem;"></i>
                </button>

                <div class="collapse navbar-collapse justify-content-end" id="navbarContent">
                    @* <form id="searchForm" class="d-flex mx-3 flex-grow-1" role="search">
                        <input id="searchInput" class="form-control form-control-sm flex-grow-1" type="search" placeholder="Search books..." aria-label="Search" />
                        <button id="searchBtn" class="btn ms-2" type="submit" style="background-color:#C7A86B; color:#2C2E43;">Search</button>
                    </form> *@

                 
                    <form id="searchForm" class="d-flex mx-3 flex-grow-1 position-relative" autocomplete="off" role="search">
                        <input id="searchInput"
                               class="form-control form-control-sm flex-grow-1"
                               type="search"
                               placeholder="Search books..."
                               aria-label="Search"
                               aria-autocomplete="list"
                               aria-controls="searchSuggestions"
                               aria-expanded="false" />

                        <button id="searchBtn"
                                class="btn ms-2"
                                type="submit"
                                style="background-color:#C7A86B; color:#2C2E43;">
                            Search
                        </button>
                      <div id="searchSuggestions" class="list-group position-absolute w-100" style="z-index:1300; top:calc(100% + .25rem); display:none;"></div>
                    </form>

                    <ul class="navbar-nav mb-2 mb-lg-0 d-flex align-items-center">
                        <li class="nav-item"><a class="nav-link text-light px-3" asp-controller="Home" asp-action="ContactUs">Contact Us</a></li>
                        <li class="nav-item"><a class="nav-link text-light px-3" asp-controller="Cart" asp-action="Index"><i class="bi bi-cart"></i> Cart</a></li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.HasClaim("Role", "Admin"))
                            {
                                <li class="nav-item"><a class="nav-link text-warning fw-bold px-3" asp-controller="Admin" asp-action="Dashboard">Admin Dashboard</a></li>
                            }

                            <li class="nav-item">
                                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="nav-link text-light bg-transparent border-0 px-3">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-light px-3" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                            <li class="nav-item"><a class="nav-link text-light px-3" asp-area="Identity" asp-page="/Account/Login">Login</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Sidebar (reference UI) -->
        <aside id="categoriesSidebar" class="sidebar" aria-hidden="true">
            <button class="closebtn" id="closeSidebar" aria-label="Close categories">&times;</button>

            <h4 class="text-light mt-3 ps-3">Categories</h4>

            <ul class="sidebar-list">
                <li class="mb-2">
                    <a asp-controller="Books" asp-action="BookList" asp-route-category="All" class="category-link">All Books</a>
                </li>

                <li>
                    <a href="#" class="category-link">Fiction</a>
                    <ul class="subcategory-list">
                        <li><a asp-controller="Books" asp-action="BookList" asp-route-category="Romance">Romance</a></li>
                        <li><a asp-controller="Books" asp-action="BookList" asp-route-category="Fantasy">Fantasy</a></li>
                        <li><a asp-controller="Books" asp-action="BookList" asp-route-category="Horror">Horror</a></li>
                        <li><a asp-controller="Books" asp-action="BookList" asp-route-category="Thriller">Thriller</a></li>
                        <li><a asp-controller="Books" asp-action="BookList" asp-route-category="Children">Children</a></li>
                    </ul>
                </li>

                <li>
                    <a href="#" class="category-link">Non-Fiction</a>
                    <ul class="subcategory-list">
                        <li><a asp-controller="Books" asp-action="BookList" asp-route-category="Islamic">Islamic</a></li>
                        <li><a asp-controller="Books" asp-action="BookList" asp-route-category="Urdu">Urdu</a></li>
                        <li><a asp-controller="Books" asp-action="BookList" asp-route-category="Self-help">Self Help</a></li>
                        <li><a asp-controller="Books" asp-action="BookList" asp-route-category="History">History</a></li>
                    </ul>
                </li>

                
            </ul>
        </aside>
    </header>

    <div class="container-fluid p-0 main-content">
        <div id="searchResults" class="container mt-3"></div>
        @RenderBody()
    </div>

    <footer>
        <div class="footer-container">
            <div class="footer-about">
                <h4>Bookaholic</h4>
                <p>"So many books, so little time 📚"</p>
            </div>

            <div class="footer-contact">
                <h4>Contact Us</h4>
                <p>Email: <a href="mailto:bookaholic@gmail.com">bookaholic@gmail.com</a></p>
                <p>Phone: +92 300 1234567</p>
            </div>

            <div class="footer-links">
                <h4>Quick Links</h4>
                <ul>
                    <li><a asp-controller="Books" asp-action="BookList" asp-route-category="Fantasy">Fantasy</a></li>
                    <li><a asp-controller="Books" asp-action="BookList" asp-route-category="Thriller">Thriller</a></li>
                    <li><a asp-controller="Books" asp-action="BookList" asp-route-category="Islamic">Islamic</a></li>
                    <li><a asp-controller="Books" asp-action="BookList" asp-route-category="Horror">Horror</a></li>
                    <li><a asp-controller="Books" asp-action="BookList" asp-route-category="Self Help">Self Help</a></li>
                    <li><a asp-controller="Books" asp-action="BookList" asp-route-category="Urdu">Urdu</a></li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            &copy; 2025 Bookaholic. Happy reading! 💛
        </div>
    </footer>

  <div id="userNotifications" aria-live="polite" aria-atomic="true"
         style="position:fixed; bottom:20px; right:20px; width:320px; z-index:12000; pointer-events:none;"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js" crossorigin="anonymous"></script>
    <script>
        (function () {
            try {
                const container = document.getElementById('userNotifications');
                if (!container) return;

                const connection = new signalR.HubConnectionBuilder()
                    .withUrl('/orderHub')
                    .withAutomaticReconnect()
                    .build();

                function showToast(html, type = 'info', duration = 8000) {
                     const id = 'user-toast-' + Date.now();
                    const div = document.createElement('div');
                     div.id = id;
                     div.className = 'toast align-items-center border-0 show';
                    div.style.pointerEvents = 'auto';
                    div.setAttribute('role', 'alert');
                    div.setAttribute('aria-live', 'polite');
                    div.setAttribute('aria-atomic', 'true');

                    let bgColor = '#0dcaf0'; 
                    let textColor = '#0f172a'; 
                    let closeClass = 'btn-close'; 

                    if (type === 'success') { bgColor = '#198754'; textColor = '#ffffff'; closeClass = 'btn-close btn-close-white'; }
                    if (type === 'danger')  { bgColor = '#dc3545'; textColor = '#ffffff'; closeClass = 'btn-close btn-close-white'; }
                    if (type === 'info')    { bgColor = '#0dcaf0'; textColor = '#0f172a'; closeClass = 'btn-close'; }

                    div.style.backgroundColor = bgColor;
                    div.style.color = textColor;
                    div.style.borderRadius = '8px';
                    div.style.padding = '0.35rem';
                 div.innerHTML = `
                    <div class="d-flex">
                        <div class="toast-body" style="color:inherit;">${html}</div>
                        <button type="button" class="${closeClass} me-2 m-auto" aria-label="Close"></button>
                    </div>`;

                    container.prepend(div);
                    const btn = div.querySelector('.btn-close');
                    if (btn) btn.addEventListener('click', () => div.remove());
                    setTimeout(() => { if (div.parentNode) div.parentNode.removeChild(div); }, duration);
                    }

                   connection.on('NewBookAdded', function (data) {
                        console.log('SignalR NewBookAdded received:', data);
                        const title = (data && (data.title || data.Title)) || '(Untitled)';
                        const html = `<strong>New:</strong> ${title}`;
                        showToast(html, 'info', 10000);
                    });

                    connection.on('BookRestocked', function (data) {
                        console.log('SignalR BookRestocked received:', data);
                        const title = (data && (data.title || data.Title)) || '(Unknown)';
                        const qtyVal = (data && (data.newQty !== undefined ? data.newQty : (data.newqty !== undefined ? data.newqty : null)));
                        const qtyText = (qtyVal !== null) ? ` — now ${qtyVal} in stock` : '';
                        const html = `<strong>Restocked:</strong> ${title}${qtyText}`;
                        showToast(html, 'success', 9000);
                    });

                connection.start().catch(function (err) {
                    console.error('SignalR (public) connection error:', err && err.toString ? err.toString() : err);
                });
            } catch (ex) {
                console.error('Failed to init public SignalR client', ex);
            }
        })();
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            const openBtn = document.getElementById('categoriesBtn');
            const closeBtn = document.getElementById('closeSidebar');
            const sidebar = document.getElementById('categoriesSidebar');

            function openSidebar() {
                sidebar.classList.add('open');
                sidebar.setAttribute('aria-hidden', 'false');
                openBtn.setAttribute('aria-expanded', 'true');
                document.documentElement.style.overflow = 'hidden';
            }

            function closeSidebar() {
                sidebar.classList.remove('open');
                sidebar.setAttribute('aria-hidden', 'true');
                openBtn.setAttribute('aria-expanded', 'false');
                document.documentElement.style.overflow = '';
            }

            openBtn && openBtn.addEventListener('click', function (e) { e.preventDefault(); openSidebar(); });
            closeBtn && closeBtn.addEventListener('click', function (e) { e.preventDefault(); closeSidebar(); });

            document.querySelectorAll('.sidebar > .sidebar-list .category-link').forEach(function (link) {
                const hasNav = link.hasAttribute('asp-controller') || link.hasAttribute('href') && !link.getAttribute('href').startsWith('#');
                link.addEventListener('click', function (e) {
                    if (link.getAttribute('href') === '#' && !hasNav) {
                        e.preventDefault();
                        const isActive = link.classList.toggle('active');
                        document.querySelectorAll('.sidebar .category-link').forEach(function (other) {
                            if (other !== link) {
                                other.classList.remove('active');
                            }
                        });
                    } else {

                        closeSidebar();
                    }
                });
            });

            document.querySelectorAll('.subcategory-list a').forEach(function (a) {
                a.addEventListener('click', function () {
                    closeSidebar();
                });
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && sidebar.classList.contains('open')) closeSidebar();
            });
        })();


        $(document).ready(function () {
            $('#searchForm').on('submit', function (e) {
                e.preventDefault();

                var query = $('#searchInput').val() ? $('#searchInput').val().trim() : '';

                if (!query) {
                    
                    if ($('#indexPage').length) {
                        $('#searchResults').hide().html('');
                        $('#indexPage').show();
                        return;
                    }
                    
                    window.location.href = '/Books/BookList';
                    return;
                }

                $.ajax({
                    url: '/Books/Search',
                    type: 'GET',
                    data: { q: query },
                    dataType: 'json',
                    cache: false,
                    timeout: 5000
                })
                .done(function (data) {
                    // Optionally you could show a preview in #searchResults here.
                    // The requirement is to navigate to the BookList page with the query.
                    window.location.href = '/Books/BookList?q=' + encodeURIComponent(query);
                })
                .fail(function () {
                    // If AJAX fails, still navigate so server-side search handles it.
                    window.location.href = '/Books/BookList?q=' + encodeURIComponent(query);
                });
            });
        });

    </script>
    <script>
        (function () {
            const input = document.getElementById('searchInput');
            const suggestions = document.getElementById('searchSuggestions');
            const form = document.getElementById('searchForm');

            if (!input || !suggestions || !form) return;

            let activeIndex = -1;
            let items = [];
            let timer = null;

            function closeSuggestions() {
                suggestions.style.display = 'none';
                suggestions.innerHTML = '';
                input.setAttribute('aria-expanded', 'false');
                activeIndex = -1;
                items = [];
            }

            function openSuggestions() {
                suggestions.style.display = '';
                input.setAttribute('aria-expanded', 'true');
            }

            function renderList(list) {
            suggestions.innerHTML = '';
            if (!list || list.length === 0) {
                closeSuggestions();
                return;
            }

            const frag = document.createDocumentFragment();
            list.forEach((it, idx) => {
                const href = (it && it.id)
                    ? `/Books/BookDetails/${encodeURIComponent(it.id)}`
                    : `/Books/BookList?q=${encodeURIComponent(it.title)}`;

                // anchor for reliable navigation + middle-click support
                const el = document.createElement('a');
                el.className = 'list-group-item list-group-item-action';
                el.style.cursor = 'pointer';
                el.setAttribute('data-id', it.id);
                el.setAttribute('data-idx', idx);
                el.setAttribute('role', 'option');
                el.href = href;
                el.textContent = it.title;

                // mousedown navigates immediately (before input blur)
                el.addEventListener('mousedown', function (e) {
                    // allow ctrl/cmd/middle-click to behave normally (do nothing)
                    if (e.button === 1 || e.ctrlKey || e.metaKey) return;
                    // navigate immediately
                    window.location.href = href;
                });

                // click handler simply closes list (navigation already handled or default anchor will run)
                el.addEventListener('click', function () {
                    closeSuggestions();
                });

                frag.appendChild(el);
            });

            suggestions.appendChild(frag);
            items = Array.from(suggestions.querySelectorAll('[data-idx]'));
            activeIndex = -1;
            openSuggestions();
        }

            async function fetchSuggestions(q) {
                try {
                    const res = await fetch(`/Books/Autocomplete?q=${encodeURIComponent(q)}`, { cache: 'no-store' });
                    if (!res.ok) return [];
                    return await res.json();
                } catch (e) {
                    console.error('Autocomplete fetch failed', e);
                    return [];
                }
            }

            function debounceFetch(q) {
                clearTimeout(timer);
                timer = setTimeout(async () => {
                    if (q.length < 2) {
                        closeSuggestions();
                        return;
                    }
                    const list = await fetchSuggestions(q);
                    renderList(list);
                }, 220);
            }

            input.addEventListener('input', function () {
                const q = (this.value || '').trim();
                debounceFetch(q);
            });

            input.addEventListener('keydown', function (e) {
                if (suggestions.style.display === 'none') return;

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    if (activeIndex < items.length - 1) activeIndex++;
                    updateActive();
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    if (activeIndex > 0) activeIndex--;
                    updateActive();
                } else if (e.key === 'Enter') {
                    if (activeIndex >= 0 && items[activeIndex]) {
                        e.preventDefault();
                        items[activeIndex].click();
                    }
                } else if (e.key === 'Escape') {
                    closeSuggestions();
                }
            });

            function updateActive() {
                items.forEach((it, idx) => {
                    if (idx === activeIndex) {
                        it.classList.add('active');
                        it.setAttribute('aria-selected', 'true');
                        it.scrollIntoView({ block: 'nearest' });
                    } else {
                        it.classList.remove('active');
                        it.setAttribute('aria-selected', 'false');
                    }
                });
            }

            input.addEventListener('blur', function () {
                setTimeout(closeSuggestions, 150);
            });

            document.addEventListener('click', function (ev) {
                if (!form.contains(ev.target)) {
                    closeSuggestions();
                }
            });

            form.addEventListener('submit', function (ev) {
                if (activeIndex >= 0 && items[activeIndex]) {
                    ev.preventDefault();
                    items[activeIndex].click();
                    return;
                }

                const q = (input.value || '').trim();
                if (!q) {
                    ev.preventDefault();
                    return;
                }

                ev.preventDefault();
                window.location.href = '/Books/BookList?q=' + encodeURIComponent(q);
            });
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>