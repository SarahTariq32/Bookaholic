                btn.addEventListener('click', function () {
                    const action = this.getAttribute('data-action');
                    let current = parseInt(qtyInput.value, 10) || 1;
                    if (action === 'decrease') current = Math.max(current - 1, parseInt(qtyInput.getAttribute('min') || '1', 10));
                    if (action === 'increase') current = Math.min(current + 1, parseInt(qtyInput.getAttribute('max') || '99', 10));
                    setQuantity(current);
                    qtyInput.focus();
                });
            });

            // Validate manual input and clamp on blur
