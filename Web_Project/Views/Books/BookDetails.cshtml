@model Web_Project.Controllers.BooksController.BookViewModel

@{
    var title = string.IsNullOrWhiteSpace(Model?.Title) ? "Book Details" : $"{Model.Title} - Book Details";
    ViewData["Title"] = title;
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/BookDetails.css" asp-append-version="true" />
}
<style>
    #bookDetailsPage {
        font-family: 'Poppins', sans-serif;
        color: #2C2E43;
        background-color: #F7F3E9;
    }

    .breadcrumb a {
        color: #2C2E43;
        text-decoration: none;
    }

        .breadcrumb a:hover {
            color: #C7A86B;
        }

    .book-detail-img {
        max-height: 450px;
        object-fit: cover;
        border-radius: 12px;
    }

    .book-title {
        font-family: 'Cinzel', serif;
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    .book-author,
    .book-genre,
    .book-price {
        font-weight: 500;
        margin-bottom: 0.3rem;
    }

    .book-description {
        font-size: 1rem;
        margin-top: 1rem;
        color: #2C2E43;
    }

    .add-to-cart {
        background-color: #2C2E43;
        color: #FAF9F6;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        border: none;
        transition: background 0.3s, transform 0.08s;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
    }

        .add-to-cart:hover {
            background-color: #C7A86B;
            color: #2C2E43;
            transform: translateY(-1px);
        }

    .other-books h4 {
        font-family: 'Cinzel', serif;
        color: #2C2E43;
    }

    .other-books .book-card {
        flex: 0 0 150px;
        background-color: #FAF9F6;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(44,46,67,0.1);
        text-align: center;
        transition: transform 0.3s ease;
        padding: 0.5rem;
    }

        .other-books .book-card:hover {
            transform: translateY(-5px);
        }

    .book-card-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-radius: 8px;
    }

    .book-card-title {
        font-size: 0.9rem;
        margin-top: 0.5rem;
        color: #2C2E43;
    }

    /* ------- Quantity control styles ------- */
    .qty-control {
        background: #FAF9F6;
        border: 1px solid rgba(44,46,67,0.06);
        border-radius: 8px;
        padding: 4px;
        gap: 6px;
    }

    .qty-btn {
        min-width: 36px;
        height: 36px;
        padding: 0;
        border-radius: 6px;
        background-color: #2C2E43;
        color: #FAF9F6;
        border: none;
        font-size: 1.25rem;
        line-height: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s, transform 0.05s;
    }

        .qty-btn:hover {
            background-color: #C7A86B;
            color: #2C2E43;
            transform: translateY(-1px);
        }

    .qty-input {
        width: 64px;
        max-width: 80px;
        height: 36px;
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        border: 1px solid rgba(44,46,67,0.12);
        background: #ffffff;
        font-size: 0.95rem;
        font-weight: 600;
        color: #2C2E43;
    }

        /* Remove native number input spinners on Chrome/Edge/Safari */
        .qty-input::-webkit-outer-spin-button,
        .qty-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        /* Remove spinner for Firefox */
        .qty-input[type=number] {
            -moz-appearance: textfield;
        }

    

    .qty-btn {
        min-width: 32px;
        height: 32px;
        font-size: 1rem;
    }

    .qty-input {
        width: 56px;
        height: 32px;
    }

    .add-to-cart {
        padding: 0.45rem 0.9rem;
    }

    }
</style>

<div id="bookDetailsPage" class="container my-5">

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-transparent p-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item">
                <a asp-controller="Books" asp-action="BookList" asp-route-category="@(Model?.CategoryName ?? "Fantasy")">
                    @(Model?.CategoryName ?? "Category")
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model?.Title</li>
        </ol>
    </nav>

    <div class="row align-items-center mb-5">
        <div class="col-md-5 text-center">
            @{
                var cover = !string.IsNullOrWhiteSpace(Model?.CoverImage)
                ? Model.CoverImage
                : Url.Content("~/images/placeholder-book.png");
            }
            <img src="@cover" alt="@Model?.Title" class="img-fluid book-detail-img shadow-sm rounded">
        </div>

        <div class="col-md-7">
            <h2 class="book-title">@Model?.Title</h2>
            <p class="book-author"><strong>Author:</strong> @(!string.IsNullOrWhiteSpace(Model?.Author) ? Model.Author : "Unknown")</p>
            <p class="book-genre"><strong>Genre:</strong> @(!string.IsNullOrWhiteSpace(Model?.CategoryName) ? Model.CategoryName : "—")</p>
            <p class="book-price"><strong>Price:</strong> PKR @((Model?.Price ?? 0m).ToString("N0"))</p>
            <p class="book-description">
                @(!string.IsNullOrWhiteSpace(Model?.Description) ? Model.Description : "No description available.")
            </p>

            <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline align-items-center mt-3" data-cart-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookId" value="@Model?.BookID" />

                <div class="d-flex align-items-center gap-2">
                    <div class="qty-control d-flex align-items-center" role="group" aria-label="Quantity selector">
                        <button type="button" class="btn qty-btn" data-action="decrease" aria-label="Decrease quantity">−</button>
                        <input type="number" name="quantity" value="1" min="1" max="99" class="form-control qty-input text-center" aria-label="Quantity" />
                        <button type="button" class="btn qty-btn" data-action="increase" aria-label="Increase quantity">+</button>
                    </div>

                    <button type="submit" class="btn add-to-cart">Add to Cart</button>
                    <a asp-controller="Books" asp-action="BookList" asp-route-category="@(Model?.CategoryName ?? "Fantasy")" class="btn btn-outline-secondary ms-2">More @((Model?.CategoryName ?? "Category")) →</a>
                </div>
            </form>

        </div>
    </div>

    <hr class="my-5">

    @if (ViewBag.RelatedBooks is IEnumerable<Web_Project.Controllers.BooksController.BookViewModel> related && related.Any())
    {
        <section class="other-books">
            <h4 class="mb-3">More @Model?.CategoryName Books</h4>
            <div class="d-flex overflow-auto gap-3 pb-3">
                @foreach (var rb in related)
                {
                    <a asp-controller="Books" asp-action="Details" asp-route-id="@rb.BookID" class="book-card text-center" style="width:150px; text-decoration:none; color:inherit;">
                        <img src="@(!string.IsNullOrWhiteSpace(rb.CoverImage) ? rb.CoverImage : Url.Content("~/images/placeholder-book.png"))" alt="@rb.Title" class="book-card-img img-fluid" />
                        <p class="book-card-title mt-2">@rb.Title</p>
                    </a>
                }
            </div>
        </section>
    }
    else
    {
        <section class="other-books">
            <h4 class="mb-3">More @Model?.CategoryName Books</h4>
            <div class="d-flex overflow-auto gap-3 pb-3">
                <div class="book-card">
                    <img src="~/images/ff2.JPG" alt="Sample" class="book-card-img">
                    <p class="book-card-title">Sample Book</p>
                </div>
                <div class="book-card">
                    <img src="~/images/ff3.JPG" alt="Sample" class="book-card-img">
                    <p class="book-card-title">Sample Book</p>
                </div>
            </div>
        </section>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.querySelector('[data-cart-form]');
            if (!form) return;

            const qtyInput = form.querySelector('.qty-input');
            const btns = form.querySelectorAll('.qty-btn');

            // Helper to clamp and format quantity
            function setQuantity(value) {
                const min = parseInt(qtyInput.getAttribute('min') || '1', 10);
                const max = parseInt(qtyInput.getAttribute('max') || '99', 10);
                let n = parseInt(value, 10) || min;
                if (n < min) n = min;
                if (n > max) n = max;
                qtyInput.value = n;
            }

            btns.forEach(btn => {
                btn.addEventListener('click', function () {
                    const action = this.getAttribute('data-action');
                    let current = parseInt(qtyInput.value, 10) || 1;
                    if (action === 'decrease') current = Math.max(current - 1, parseInt(qtyInput.getAttribute('min') || '1', 10));
                    if (action === 'increase') current = Math.min(current + 1, parseInt(qtyInput.getAttribute('max') || '99', 10));
                    setQuantity(current);
                    qtyInput.focus();
                });
            });

            // Ensure manual entry stays valid
            qtyInput.addEventListener('input', function () {
                // Allow user to type but clamp on blur
                const v = this.value;
                if (!/^\d*$/.test(v)) {
                    // remove non-digits
                    this.value = v.replace(/\D/g, '');
                }
            });

            qtyInput.addEventListener('blur', function () {
                setQuantity(this.value);
            });

            // Prevent form submit on enter inside number input from triggering other things
            qtyInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    // optionally submit
                }
            });
        })();
    </script>
} *@

