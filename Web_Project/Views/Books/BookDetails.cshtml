                    const expanded = this.getAttribute('aria-expanded') === 'true';
                    if (more) {
                        more.style.display = expanded ? 'none' : 'inline';
                        this.textContent = expanded ? 'Read more' : 'Show less';
                        this.setAttribute('aria-expanded', (!expanded).toString());
                    }
                });
            }

            // Quantity controls
            const form = document.querySelector('[data-cart-form]');
            if (!form) return;

            const qtyInput = form.querySelector('.qty-input');
            const btns = form.querySelectorAll('.qty-btn');

            function setQuantity(value) {
                const min = parseInt(qtyInput.getAttribute('min') || '1', 10);
                const max = parseInt(qtyInput.getAttribute('max') || '99', 10);
                let n = parseInt(value, 10) || min;
                if (n < min) n = min;
                if (n > max) n = max;
                qtyInput.value = n;
