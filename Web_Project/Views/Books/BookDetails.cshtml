@model Web_Project.Controllers.BooksController.BookViewModel
@{

    var pageTitle = string.IsNullOrWhiteSpace(Model?.Title) ? "Book Details" : $"{Model.Title} - Book Details";
    ViewData["Title"] = pageTitle;
    Layout = "_Layout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/BookDetails.css" asp-append-version="true" />
}

<div id="bookDetailsPage" class="container my-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-transparent p-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item">
                <a asp-controller="Books" asp-action="BookList" asp-route-category="@(Model?.CategoryName ?? "Fantasy")">
                    @(Model?.CategoryName ?? "Category")
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model?.Title</li>
        </ol>
    </nav>

    <div class="row align-items-center mb-5">
        <div class="col-md-5 text-center">
            @{
                var cover = !string.IsNullOrWhiteSpace(Model?.CoverImage)
                ? Model.CoverImage.Replace(" ", "%20")
                : Url.Content("~/images/placeholder-book.png");
            }
            <img src="@cover" alt="@Model?.Title" class="img-fluid book-detail-img shadow-sm rounded" />
        </div>

        <div class="col-md-7">
            <h2 class="book-title">@Model?.Title</h2>
            <p class="book-author"><strong>Author:</strong> @(!string.IsNullOrWhiteSpace(Model?.Author) ? Model.Author : "Unknown")</p>
            <p class="book-genre"><strong>Genre:</strong> @(!string.IsNullOrWhiteSpace(Model?.CategoryName) ? Model.CategoryName : "—")</p>
            <p class="book-price"><strong>Price:</strong> PKR @((Model?.Price ?? 0m).ToString("N0"))</p>

            <p class="mb-2">
                @if (Model.StockQuantity > 0)
                {
                    <span id="stockBadge" class="badge bg-success">In stock: <span id="stockQty">@Model.StockQuantity</span></span>
                }
                else
                {
                    <span id="stockBadge" class="badge bg-danger">Out of stock</span>
                }
            </p>

            <p class="book-description">
                @(!string.IsNullOrWhiteSpace(Model?.Description) ? Model.Description : "No description available.")
            </p>

            <div id="cartArea" class="d-inline align-items-center mt-3">
                @if (Model.StockQuantity > 0)
                {
                    <form id="addToCartForm" asp-controller="Cart" asp-action="Add" method="post" class="d-inline align-items-center" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookId" value="@Model?.BookID" />
                        <div class="d-flex align-items-center gap-2">
                            <div class="qty-control d-flex align-items-center" role="group" aria-label="Quantity selector">
                                <button type="button" id="decreaseBtn" class="btn qty-btn" data-action="decrease" aria-label="Decrease quantity">−</button>
                                <input id="qtyInput" type="number" name="quantity" value="1" min="1" max="99" class="form-control qty-input text-center" aria-label="Quantity" />
                                <button type="button" id="increaseBtn" class="btn qty-btn" data-action="increase" aria-label="Increase quantity">+</button>
                            </div>

                            <button id="addToCartBtn" type="submit" class="btn add-to-cart">Add to Cart</button>
                            <a asp-controller="Books" asp-action="BookList" asp-route-category="@(Model?.CategoryName ?? "Fantasy")" class="btn btn-outline-secondary ms-2">More @((Model?.CategoryName ?? "Category")) →</a>
                        </div>

                        <div id="stockError" class="form-text text-danger mt-2" style="display:none;"></div>
                    </form>
                }
                else
                {
                    <div class="d-inline align-items-center">
                        <button class="btn btn-secondary" type="button" disabled aria-disabled="true">Out of Stock</button>
                        <a asp-controller="Books" asp-action="BookList" asp-route-category="@(Model?.CategoryName ?? "Fantasy")" class="btn btn-outline-secondary ms-2">More @((Model?.CategoryName ?? "Category")) →</a>
                    </div>
                }
            </div>

            <div id="cartNotifications" aria-live="polite" aria-atomic="true" class="mt-3"></div>
        </div>
    </div>

    <hr class="my-5">

    @{

        var relatedEnumerable = ViewBag.RelatedBooks as System.Collections.IEnumerable;
        var relatedList = new List<dynamic>();
        if (relatedEnumerable != null)
        {
            foreach (var _r in relatedEnumerable)
            {
                relatedList.Add(_r);
            }
        }
    }

    <section class="other-books">
        <h4 class="mb-3">More @Model?.CategoryName Books</h4>

        @if (relatedList.Any())
        {
            <div class="d-flex overflow-auto gap-3 pb-3">
                @foreach (var rb in relatedList)
                {

                    var id = (rb?.BookID ?? rb?.BookId ?? rb?.Id) ?? 0;
                    var title = rb?.Title ?? "Untitled";
                    var coverRaw = rb?.CoverImage as string;
                    var coverUrl = !string.IsNullOrWhiteSpace(coverRaw) ? coverRaw.Replace(" ", "%20") : Url.Content("~/images/placeholder-book.png");
                    <a asp-controller="Books" asp-action="BookDetails" asp-route-id="@id" class="book-card text-center" style="width:150px; text-decoration:none; color:inherit;">
                        <img src="@coverUrl" alt="@title" class="book-card-img img-fluid" loading="lazy" />
                        <p class="book-card-title mt-2 small">@title</p>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="d-flex overflow-auto gap-3 pb-3">
                <div class="book-card">
                    <img src="~/images/ff2.JPG" alt="Sample" class="book-card-img" loading="lazy" />
                    <p class="book-card-title mt-2 small">Sample Book</p>
                </div>
                <div class="book-card">
                    <img src="~/images/ff3.JPG" alt="Sample" class="book-card-img" loading="lazy" />
                    <p class="book-card-title mt-2 small">Sample Book</p>
                </div>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js" crossorigin="anonymous"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const bookId = @Model.BookID;
            const qtyInput = document.getElementById('qtyInput');
            const decreaseBtn = document.getElementById('decreaseBtn');
            const increaseBtn = document.getElementById('increaseBtn');
            const addToCartForm = document.getElementById('addToCartForm');
            const stockQtyEl = document.getElementById('stockQty');
            const stockError = document.getElementById('stockError');
            const cartNotifications = document.getElementById('cartNotifications');
            const cartArea = document.getElementById('cartArea');

            let availableStock = 0;
            if (stockQtyEl) availableStock = parseInt(stockQtyEl.textContent || '0', 10);

            function showInlineError(msg) {
                if (!stockError) return;
                stockError.textContent = msg;
                stockError.style.display = 'block';
            }
            function clearInlineError() {
                if (!stockError) return;
                stockError.textContent = '';
                stockError.style.display = 'none';
            }

            function showToast(message, type = 'success') {
                const id = 'toast-' + Date.now();
                const div = document.createElement('div');
                div.id = id;
                div.className = 'toast align-items-center text-bg-' + (type === 'success' ? 'success' : 'danger') + ' border-0 show';
                div.setAttribute('role', 'alert');
                div.setAttribute('aria-live', 'assertive');
                div.setAttribute('aria-atomic', 'true');
                div.style.marginBottom = '0.5rem';
                div.innerHTML = `
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" aria-label="Close"></button>
                    </div>`;
                cartNotifications.prepend(div);
                div.querySelector('.btn-close').addEventListener('click', () => div.remove());
                setTimeout(() => { if (div.parentNode) div.parentNode.removeChild(div); }, 6000);
            }

            function clampQuantity(n) {
                const min = parseInt(qtyInput.getAttribute('min') || '1', 10);
                const max = parseInt(qtyInput.getAttribute('max') || '99', 10);
                let v = parseInt(n, 10) || min;
                if (v < min) v = min;
                if (v > max) v = max;
                return v;
            }

            if (decreaseBtn && increaseBtn && qtyInput) {
                decreaseBtn.addEventListener('click', function () {
                    qtyInput.value = clampQuantity((parseInt(qtyInput.value || '1', 10) - 1));
                    clearInlineError();
                });
                increaseBtn.addEventListener('click', function () {
                    qtyInput.value = clampQuantity((parseInt(qtyInput.value || '1', 10) + 1));
                    clearInlineError();
                });
            }

            if (qtyInput) {
                qtyInput.addEventListener('input', function () {
                    this.value = this.value.replace(/\D/g, '');
                    clearInlineError();
                });
                qtyInput.addEventListener('blur', function () {
                    this.value = clampQuantity(this.value);
                });
            }

            // Intercept add-to-cart submit: client-side stock check + AJAX post
            if (addToCartForm) {
                addToCartForm.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    clearInlineError();

                    const qty = clampQuantity(qtyInput ? qtyInput.value : '1');

                    if (qty <= 0) {
                        showInlineError('Please choose a valid quantity.');
                        return;
                    }

                    if (qty > availableStock) {
                        showInlineError(`Only ${availableStock} in stock — you requested ${qty}. You cannot add that many.`);
                        return;
                    }

                    const fd = new FormData(addToCartForm);

                    try {
                        const res = await fetch(addToCartForm.action || '/Cart/Add', {
                            method: 'POST',
                            credentials: 'same-origin',
                            body: fd,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        if (res.ok) {
                            let json = null;
                            try { json = await res.json(); } catch { json = null; }

                            if (json && json.success === false) {
                                showInlineError(json.message || 'Unable to add to cart.');
                                return;
                            }

                            showToast(json && json.message ? json.message : 'Item added to cart', 'success');

                            if (qtyInput) qtyInput.value = '1';
                        } else {
                            let text = await res.text();
                            try {
                                const j = JSON.parse(text);
                                if (j && j.message) text = j.message;
                            } catch { /* ignore */ }
                            showInlineError(text || 'Failed to add to cart.');
                        }
                    } catch (err) {
                        console.error('Add to cart failed', err);
                        showInlineError('Error adding to cart. Please try again.');
                    }
                });
            }

            try {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/orderHub")
                    .withAutomaticReconnect()
                    .build();

                connection.on("StockUpdated", function (data) {
                    try {
                        if (!data || parseInt(data.bookId) !== parseInt(bookId)) return;

                        const newQty = parseInt(data.newQty ?? data.newQuantity ?? data.newstock ?? -1, 10);
                        if (isNaN(newQty)) return;

                        availableStock = newQty;
                        if (stockQtyEl) stockQtyEl.textContent = String(newQty);

                        if (newQty <= 0) {
                            if (cartArea) {
                                cartArea.innerHTML = '<div class="d-inline align-items-center"><button class="btn btn-secondary" type="button" disabled aria-disabled="true">Out of Stock</button> <a href="@Url.Action("BookList", "Books", new { category = Model?.CategoryName ?? "Fantasy" })" class="btn btn-outline-secondary ms-2">More →</a></div>';
                            }
                            showToast('This item is now out of stock.', 'danger');
                        }
                    } catch (ex) {
                        console.error('StockUpdated handler error', ex);
                    }
                });

                connection.start().catch(function (err) {
                    console.error("SignalR connection error:", err.toString());
                });
            } catch (ex) {
                console.warn('SignalR not available:', ex);
            }
        });
    </script>
}