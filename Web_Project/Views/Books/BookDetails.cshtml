                const v = this.value;
                if (!/^\d*$/.test(v)) {
                    this.value = v.replace(/\D/g, '');
                }
            });

            qtyInput.addEventListener('blur', function () {
                setQuantity(this.value);
            });

            qtyInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') e.preventDefault();
            });
        })();
    </script>
} *@

