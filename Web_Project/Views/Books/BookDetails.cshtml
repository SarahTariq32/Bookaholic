@* @model Web_Project.Controllers.BooksController.BookViewModel

@{
    var title = string.IsNullOrWhiteSpace(Model?.Title) ? "Book Details" : $"{Model.Title} - Book Details";
    ViewData["Title"] = title;
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/BookDetails.css" asp-append-version="true" />
    <style>
        /* --- Hide native number spinners (Chrome / Safari / Edge / Opera / Firefox) --- */
        input.qty-input::-webkit-outer-spin-button,
        input.qty-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        input.qty-input {
            -moz-appearance: textfield; /* Firefox */
            -webkit-appearance: none;
            appearance: none;
        }

        /* --- Related book cards sizing (consistent) --- */
        .other-books .books-container {
            display: flex;
            gap: 1rem;
            overflow-x: auto;
            padding-bottom: .5rem;
            align-items: flex-start;
        }

        .other-books .book-card {
            flex: 0 0 150px; /* fixed width */
            width: 150px;
            background: #fff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 6px 18px rgba(0,0,0,0.06);
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            align-items: stretch;
        }

            .other-books .book-card img,
            .other-books .book-card .book-card-img {
                width: 100%;
                height: 160px;
                object-fit: cover;
                display: block;
                border-bottom-left-radius: 0;
                border-bottom-right-radius: 0;
            }

        .other-books .book-info {
            padding: .5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: .35rem;
            min-height: 76px; /* keep cards equal height visually */
        }

        .other-books .book-title {
            font-size: 0.9rem;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin: 0;
            text-align: center;
        }

        .other-books .book-price {
            color: #c7a86b;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .other-books .see-more {
            margin-top: .25rem;
            font-weight: 600;
            text-decoration: none;
            color: #1f2937;
            border: 1px solid rgba(31,41,55,0.06);
            padding: .25rem .45rem;
            border-radius: 6px;
            display: inline-block;
        }
    </style>
}

