
 @model List<Web_Project.Controllers.BooksController.BookViewModel>

@{
    var categoryName = (string)(ViewData["CategoryName"] ?? "Books");
    ViewData["Title"] = $"{categoryName} Books";
    var currentPage = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var categoryRoute = (string)(ViewBag.CategoryRoute ?? categoryName);
}

@section Styles {
    <link rel="stylesheet" href="~/css/booklist.css" asp-append-version="true" />
}

<div id="bookListPage" class="container my-4">
    <section class="category-title mb-3">
        <h1 class="text-capitalize">@categoryName Books</h1>
        <p class="text-muted">Explore the best selections in <strong class="text-capitalize">@categoryName</strong>. Find your next read! 📚</p>
    </section>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No books found.</div>
    }
    else
    {
        <section class="books-grid d-grid" style="grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:1.5rem;">
            @foreach (var book in Model)
            {
                var img = string.IsNullOrWhiteSpace(book.CoverImage)
                          ? Url.Content("~/images/placeholder-book.png")
                          : Url.Content(book.CoverImage).Replace(" ", "%20");

                <article class="book-card" role="article" aria-label="@book.Title" style="background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 6px 18px rgba(0,0,0,0.06);">
                        <img src="@img" alt="@book.Title" style="width:100%;height:220px;object-fit:cover;display:block;" loading="lazy" />
                        <div class="book-info p-2 d-flex flex-column"> 
                        <p class="book-title mb-1 text-truncate" title="@book.Title" style="font-weight:600;margin:0;">@book.Title</p>
                        <p class="book-price mb-2" style="color:#c7a86b;font-weight:700;margin:0;">PKR @book.Price.ToString("N0")</p>
                        <div class="mt-auto">
                            <a asp-controller="Books" asp-action="BookDetails" asp-route-id="@book.BookID" class="see-more btn btn-sm btn-outline-secondary" style="font-weight:600;">View Details →</a>
                        </div>
                    </div>
                </article>
            }
        </section>

        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination pagination-custom justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-controller="Books" asp-action="BookList" asp-route-category="@categoryRoute" asp-route-page="@(currentPage - 1)">Previous</a>
                </li>

                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")" aria-current="@(p == currentPage ? "page" : null)">
                        <a class="page-link" asp-controller="Books" asp-action="BookList" asp-route-category="@categoryRoute" asp-route-page="@p">@p</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-controller="Books" asp-action="BookList" asp-route-category="@categoryRoute" asp-route-page="@(currentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div> 




