                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-controller="Books" asp-action="BookList" asp-route-category="@categoryRoute" asp-route-page="@(currentPage - 1)">Previous</a>
                </li>

                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")" aria-current="@(p == currentPage ? "page" : null)">
                        <a class="page-link" asp-controller="Books" asp-action="BookList" asp-route-category="@categoryRoute" asp-route-page="@p">@p</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-controller="Books" asp-action="BookList" asp-route-category="@categoryRoute" asp-route-page="@(currentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div> 



@* @model List<Web_Project.Controllers.BooksController.BookViewModel>

@{
    var categoryName = (string)(ViewData["CategoryName"] ?? "Books");
    ViewData["Title"] = $"{categoryName} Books";
    var currentPage = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var categoryRoute = (string)(ViewBag.CategoryRoute ?? categoryName);
}

@section Styles {
    <link rel="stylesheet" href="~/css/booklist.css" asp-append-version="true" />
}

<div id="bookListPage" class="container my-4">
    <section class="category-title mb-3">
        <h1 class="text-capitalize">@categoryName Books</h1>
        <p class="text-muted">Explore the best selections in <strong class="text-capitalize">@categoryName</strong>. Find your next read! 📚</p>
    </section>

    <!-- Search UI -->
    <div class="mb-3" style="max-width:720px;">
        <div class="input-group">
            <input id="bookSearchInput" type="search" class="form-control" placeholder="Search by title, author or category..." aria-label="Search books" autocomplete="off" />
            <button id="bookSearchClear" class="btn btn-outline-secondary" type="button" title="Clear">Clear</button>
        </div>
        <div id="bookSearchResults" class="list-group mt-2" style="display:none;" role="listbox" aria-live="polite"></div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No books found.</div>
    }
    else
    {
        <section class="books-grid d-grid" style="grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:1.5rem;">
            @foreach (var book in Model)
            {
                var img = string.IsNullOrWhiteSpace(book.CoverImage)
                          ? Url.Content("~/images/placeholder-book.png")
                          : Url.Content(book.CoverImage).Replace(" ", "%20");

                <article class="book-card" role="article" aria-label="@book.Title" style="background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 6px 18px rgba(0,0,0,0.06);">
                    <img src="@img" alt="@book.Title" style="width:100%;height:220px;object-fit:cover;display:block;" loading="lazy" />
                    <div class="book-info p-2 d-flex flex-column">
                        <p class="book-title mb-1 text-truncate" title="@book.Title" style="font-weight:600;margin:0;">@book.Title</p>
                        <p class="book-price mb-2" style="color:#c7a86b;font-weight:700;margin:0;">PKR @book.Price.ToString("N0")</p>
                        <div class="mt-auto">
                            <a asp-controller="Books" asp-action="BookDetails" asp-route-id="@book.BookID" class="see-more btn btn-sm btn-outline-secondary" style="font-weight:600;">View Details →</a>
                        </div>
                    </div>
                </article>
            }
        </section>

        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination pagination-custom justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-controller="Books" asp-action="BookList" asp-route-category="@categoryRoute" asp-route-page="@(currentPage - 1)">Previous</a>
                </li>

                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")" aria-current="@(p == currentPage ? "page" : null)">
                        <a class="page-link" asp-controller="Books" asp-action="BookList" asp-route-category="@categoryRoute" asp-route-page="@p">@p</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-controller="Books" asp-action="BookList" asp-route-category="@categoryRoute" asp-route-page="@(currentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            var $input = $('#bookSearchInput');
            var $clear = $('#bookSearchClear');
            var $results = $('#bookSearchResults');
            var debounceTimer = null;
            var DEBOUNCE_MS = 300;
            var MIN_LEN = 2;

            function escapeHtml(str) {
                return String(str || '').replace(/[&<>"']/g, function (m) {
                    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m];
                });
            }

            function render(items) {
                $results.empty();
                if (!items || items.length === 0) {
                    $results.hide();
                    return;
                }

                items.forEach(function (it) {
                    var $a = $('<a/>', {
                        'class': 'list-group-item list-group-item-action d-flex align-items-center',
                        'href': '/Books/BookDetails?id=' + encodeURIComponent(it.id),
                        'role': 'option'
                    });
                    var $img = $('<img/>', {
                        src: it.cover,
                        alt: it.title,
                        class: 'me-2 rounded',
                        css: { width: '48px', height: '64px', objectFit: 'cover' }
                    });
                    var $div = $('<div/>').html(
                        '<div class="fw-semibold" style="font-size:.95rem">' + escapeHtml(it.title) + '</div>' +
                        '<div class="text-muted small">' + escapeHtml(it.author || '') + ' — <em>' + escapeHtml(it.category || '') + '</em></div>'
                    );
                    $a.append($img).append($div);
                    $results.append($a);
                });

                $results.show();
            }

            function search(query) {
                if (!query || query.length < MIN_LEN) {
                    $results.hide().empty();
                    return;
                }

                $.ajax({
                    url: '/Books/Search',
                    method: 'GET',
                    data: { q: query },
                    dataType: 'json',
                    cache: false
                })
                .done(function (data) {
                    render(data);
                })
                .fail(function () {
                    $results.hide().empty();
                });
            }

            $input.on('input', function () {
                clearTimeout(debounceTimer);
                var q = $(this).val().trim();
                debounceTimer = setTimeout(function () { search(q); }, DEBOUNCE_MS);
            });

            $input.on('keydown', function (e) {
                if (e.key === 'Escape') { $input.val(''); $results.hide().empty(); }
            });

            $clear.on('click', function () { $input.val('').trigger('input').focus(); });

            $(document).on('click', function (e) {
                if (!$(e.target).closest('#bookSearchResults, #bookSearchInput, #bookSearchClear').length) {
                    $results.hide();
                }
            });

            $input.on('keydown', function (e) {
                var $items = $results.children('a');
                if (!$items.length || (e.key !== 'ArrowDown' && e.key !== 'ArrowUp' && e.key !== 'Enter')) return;

                var idx = $items.index($items.filter('.active'));
                if (e.key === 'ArrowDown') {
                    idx = Math.min($items.length - 1, Math.max(-1, idx) + 1);
                } else if (e.key === 'ArrowUp') {
                    idx = Math.max(-1, idx - 1);
                } else if (e.key === 'Enter') {
                    if (idx >= 0) {
                        window.location = $items.eq(idx).attr('href');
                        e.preventDefault();
                    }
                }
                $items.removeClass('active');
                if (idx >= 0) $items.eq(idx).addClass('active').focus();
            });
        });
    </script>
}


