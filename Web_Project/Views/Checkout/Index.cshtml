
@model Web_Project.Models.ViewModels.CheckoutVM

@{
    ViewData["Title"] = "Checkout";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
}

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-md-7">
            <div class="checkout-form p-4">
                <h3 class="mb-4">Checkout</h3>

                <form asp-controller="Checkout" asp-action="PlaceOrder" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="CustomerName" class="form-label"></label>
                        <input asp-for="CustomerName" class="form-control" />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CustomerEmail" class="form-label"></label>
                        <input asp-for="CustomerEmail" class="form-control" />
                        <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CustomerPhone" class="form-label"></label>
                        <input asp-for="CustomerPhone" class="form-control" />
                        <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Zip" class="form-label"></label>
                            <input asp-for="Zip" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PaymentMethod" class="form-label"></label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="">Choose payment method</option>
                            <option value="COD">Cash on Delivery</option>
                            <option value="Card">Debit / Credit Card</option>
                            <option value="BankTransfer">Bank Transfer</option>
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary mt-3 w-100">Place Order</button>
                </form>
            </div>
        </div>

        <div class="col-md-5">
            <div class="order-summary p-4">
                <h4 class="mb-3">Order Summary</h4>

                @if (Model?.Items == null || !Model.Items.Any())
                {
                    <div class="alert alert-info">Your cart is empty.</div>
                }
                else
                {
                    <div class="mb-3">
                        @foreach (var it in Model.Items)
                        {
                            <div class="d-flex mb-2">
                                <img src="@(string.IsNullOrWhiteSpace(it.CoverImage) ? Url.Content("~/images/placeholder-book.png") : it.CoverImage)" style="width:60px; height:80px; object-fit:cover; border-radius:6px;" />
                                <div class="ms-2 flex-grow-1">
                                    <div class="fw-semibold">@it.Title</div>
                                    <div class="small text-muted">PKR @it.Price.ToString("N0") × @it.Quantity</div>
                                </div>
                                <div class="text-end fw-bold">PKR @(it.LineTotal.ToString("N0"))</div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between">
                        <p>Subtotal</p>
                        <p>PKR @Model.Subtotal.ToString("N0")</p>
                    </div>
                    <div class="d-flex justify-content-between">
                        <p>Shipping Fee</p>
                        <p>PKR @Model.ShippingFee.ToString("N0")</p>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between total">
                        <h5>Total</h5>
                        <h5>PKR @Model.Total.ToString("N0")</h5>
                    </div>

                    <div class="mt-4 text-muted">
                        <small>Estimated delivery: 3–5 business days</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}