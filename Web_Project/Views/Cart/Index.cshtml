@{
    ViewData["Title"] = "Cart";
    Layout = "_Layout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
}

<div class="container py-5">
    <h2 class="text-center mb-5 fw-bold">Your Cart 🛒</h2>

    <div class="cart-items">
        <div class="cart-item d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
            <div class="d-flex align-items-center">
                <img src="~/images/FF1.JPG" alt="Powerless" class="cart-img rounded">
                <div class="ms-3">
                    <h5 class="mb-1 fw-semibold">Powerless</h5>
                    <p class="mb-1 text-muted small">by Lauren Roberts</p>
                    <p class="mb-0 fw-bold">Rs. 1,999</p>
                </div>
            </div>
            <button class="btn btn-outline-danger btn-sm">Remove</button>
        </div>

        <div class="cart-item d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
            <div class="d-flex align-items-center">
                <img src="~/images/FF2.JPG" alt="Powerful" class="cart-img rounded">
                <div class="ms-3">
                    <h5 class="mb-1 fw-semibold">Powerful</h5>
                    <p class="mb-1 text-muted small">by Lauren Roberts</p>
                    <p class="mb-0 fw-bold">Rs. 2,199</p>
                </div>
            </div>
            <button class="btn btn-outline-danger btn-sm">Remove</button>
        </div>

        <div class="cart-item d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
            <div class="d-flex align-items-center">
                <img src="~/images/FF3.JPG" alt="Once Upon a Broken Heart" class="cart-img rounded">
                <div class="ms-3">
                    <h5 class="mb-1 fw-semibold">Once Upon a Broken Heart</h5>
                    <p class="mb-1 text-muted small">by Stephanie Garber</p>
                    <p class="mb-0 fw-bold">Rs. 1,799</p>
                </div>
            </div>
            <button class="btn btn-outline-danger btn-sm">Remove</button>
        </div>

        <div class="cart-item d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
            <div class="d-flex align-items-center">
                <img src="~/images/FF4.JPG" alt="Curse for True Love" class="cart-img rounded">
                <div class="ms-3">
                    <h5 class="mb-1 fw-semibold">Curse for True Love</h5>
                    <p class="mb-1 text-muted small">by Stephanie Garber</p>
                    <p class="mb-0 fw-bold">Rs. 1,999</p>
                </div>
            </div>
            <button class="btn btn-outline-danger btn-sm">Remove</button>
        </div>

        <div class="cart-item d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
            <div class="d-flex align-items-center">
                <img src="~/images/FF5.JPG" alt="The Queen of Nothing" class="cart-img rounded">
                <div class="ms-3">
                    <h5 class="mb-1 fw-semibold">The Queen of Nothing</h5>
                    <p class="mb-1 text-muted small">by Lauren Roberts</p>
                    <p class="mb-0 fw-bold">Rs. 2,299</p>
                </div>
            </div>
            <button class="btn btn-outline-danger btn-sm">Remove</button>
        </div>
    </div>

    <div class="cart-summary mt-5 text-end">
        <h5 class="fw-semibold">Total: <span class="text-primary">Rs. 10,295</span></h5>
        <div class="mt-4">
            <a href="/Home/BookList" class="btn btn-outline-primary me-3">Continue Shopping</a>
            <a asp-controller="Home" asp-action="Checkout" class="btn btn-primary">Checkout</a>

        </div>
    </div>
</div>
