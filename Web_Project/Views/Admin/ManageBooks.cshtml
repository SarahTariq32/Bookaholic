@model List<Web_Project.Models.Book>

@{
    Layout = "_AdminLayout";
}

<style>
    /* Category toggle styling */
    .category-toggle {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        width: 100%;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        background: #F8FAFC; /* light card-like background */
        border: 1px solid #E6EDF3;
        color: #0f172a; /* dark text */
        text-decoration: none;
        font-weight: 600;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }

        .category-toggle:hover,
        .category-toggle:focus {
            background: #EEF2F6;
            text-decoration: none;
            color: #0f172a;
        }

        .category-toggle .chev {
            display: inline-block;
            transition: transform .18s ease;
            font-size: 0.85rem;
            line-height: 1;
            margin-right: 0.5rem;
        }

        /* rotate chevron when expanded (bootstrap sets aria-expanded on the button) */
        .category-toggle[aria-expanded="true"] .chev {
            transform: rotate(90deg);
        }

    /* Make the header and small hint visually balanced */
    .category-header-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .category-count-badge {
        background: #1F2937;
        color: #fff;
        border-radius: 999px;
        padding: 0.25rem 0.6rem;
        font-size: 0.85rem;
        font-weight: 600;
    }

    /* Slight spacing tweak between toggle and collapsed table */
    .category-collapse-wrapper {
        margin-top: 0.5rem;
    }
</style>

<h2 class="mb-4">Manage Books</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="add-book-card mb-4">
    <h5>Add New Book</h5>
    <form method="post" asp-action="AddBook" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="Title" class="form-label">Title</label>
                <input type="text" name="Title" class="form-control" placeholder="Enter book title" required />
            </div>
            <div class="col-md-6 mb-3">
                <label for="Author" class="form-label">Author</label>
                <input type="text" name="Author" class="form-control" placeholder="Enter author name" required />
            </div>
            <div class="col-md-6 mb-3">
                <label for="CategoryID" class="form-label">Category</label>
                <select name="CategoryID" class="form-select" required>
                    @foreach (var category in (List<Web_Project.Models.Category>)ViewBag.Categories)
                    {
                        <option value="@category.CategoryID">@category.CategoryName</option>
                    }
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label for="Price" class="form-label">Price</label>
                <input type="number" name="Price" class="form-control" placeholder="Enter book price" step="0.01" required />
            </div>
            <div class="col-md-6 mb-3">
                <label for="StockQuantity" class="form-label">Stock</label>
                <input type="number" name="StockQuantity" class="form-control" placeholder="Enter stock quantity" required />
            </div>
            <div class="col-md-6 mb-3">
                <label for="ImageName" class="form-label">Cover Image Name</label>
                <input type="text" name="ImageName" class="form-control" placeholder="e.g. harry_potter_1" required />
                <small class="text-muted">Image must already exist in the correct category folder (no extension needed)</small>
            </div>
            <div class="col-md-12 mb-3">
                <label for="Description" class="form-label">Description</label>
                <textarea name="Description" class="form-control" rows="4" placeholder="Enter book description"></textarea>
            </div>
        </div>
        <button type="submit" class="btn btn-blue mt-3">Add Book</button>
    </form>
</div>

<div class="books-table-card">
    <h5>Books by Category</h5>

    @if (Model != null && Model.Any())
    {
        var groupedBooks = Model.GroupBy(b => b.CategoryID);
        foreach (var categoryGroup in groupedBooks)
        {
            var collapseId = $"categoryCollapse{categoryGroup.Key}";
            <div class="category-collapse-wrapper">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="category-header-row w-100">
                        <button class="category-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                            <span class="d-flex align-items-center">
                                <span class="chev">&#9658;</span>
                                <span>@ViewBag.CategoryNames[categoryGroup.Key]</span>
                            </span>
                            <span class="category-count-badge">@categoryGroup.Count()</span>
                        </button>
                    </div>
                </div>

                <div class="collapse mb-4" id="@collapseId">
                    <table class="table table-bordered table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Title</th>
                                <th>Author</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var book in categoryGroup)
                            {
                                <tr>
                                    <td>@book.Title</td>
                                    <td>@book.Author</td>
                                    <td>@book.Price.ToString("C")</td>
                                    <td>@book.StockQuantity</td>
                                    <td>
                                        <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#editBookModal@book.BookID">Edit</button>

                                        <div class="modal fade" id="editBookModal@book.BookID" tabindex="-1" aria-labelledby="editBookLabel@book.BookID" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Edit Book: @book.Title</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <form method="post" asp-action="EditBook">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="BookID" value="@book.BookID" />
                                                            <input type="hidden" name="CoverImage" value="@book.CoverImage" />
                                                            <div class="mb-3">
                                                                <label>Title</label>
                                                                <input type="text" name="Title" class="form-control" value="@book.Title" required />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label>Author</label>
                                                                <input type="text" name="Author" class="form-control" value="@book.Author" required />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label>Category</label>
                                                                <select name="CategoryID" class="form-select">
                                                                    @foreach (var category in (List<Web_Project.Models.Category>)ViewBag.Categories)
                                                                    {
                                                                        if (book.CategoryID == category.CategoryID)
                                                                        {
                                                                            <option value="@category.CategoryID" selected>@category.CategoryName</option>
                                                                        }
                                                                        else
                                                                        {
                                                                            <option value="@category.CategoryID">@category.CategoryName</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label>Price</label>
                                                                <input type="number" name="Price" class="form-control" value="@book.Price" step="0.01" required />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label>Stock</label>
                                                                <input type="number" name="StockQuantity" class="form-control" value="@book.StockQuantity" required />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label>Description</label>
                                                                <textarea name="Description" class="form-control" rows="3">@book.Description</textarea>
                                                            </div>
                                                            <button type="submit" class="btn btn-blue">Save Changes</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <form method="post" asp-action="DeleteBook" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@book.BookID" />
                                            <button type="submit" class="btn btn-red btn-sm">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <p>No books found.</p>
    }
</div>