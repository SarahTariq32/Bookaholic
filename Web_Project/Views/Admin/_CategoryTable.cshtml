@model List<Category>

<table class="table table-dark table-hover">
    <thead>
        <tr><th>Name</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.CategoryName</td>
                <td>
                    <a href="/Admin/DeleteCategory/@c.CategoryID" class="btn btn-sm btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
