@{
    ViewData["Title"] = "Admin Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <style>
        body {
            background-color: #E5DCC5;
            color: #2C2E43;
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            margin: 0;
            padding: 0;
        }

        .dashboard-header {
            background-color: #F7F3E9;
            padding: 1.5rem 2rem;
            border-bottom: 1px solid rgba(44, 46, 67, 0.2);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .dashboard-header h1 {
                font-family: 'Cinzel', serif;
                font-weight: 600;
                color: #2C2E43;
                margin: 0;
            }

        .logout-btn {
            background-color: #2C2E43;
            color: #FAF9F6;
            font-weight: 600;
            border: none;
            padding: 0.4rem 0.8rem;
            border-radius: 5px;
            transition: 0.2s;
        }

            .logout-btn:hover {
                background-color: #C7A86B;
                color: #2C2E43;
            }

        .dashboard-container {
            padding: 2rem;
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
        }

        .dashboard-card {
            background-color: #FAF9F6;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(44,46,67,0.1);
            padding: 1.5rem;
            text-align: center;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .dashboard-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 6px 12px rgba(44,46,67,0.2);
            }

            .dashboard-card h3 {
                color: #2C2E43;
                margin-bottom: 1rem;
                font-family: 'Cinzel', serif;
            }

            .dashboard-card p {
                font-size: 0.95rem;
                color: #2C2E43;
                margin-bottom: 1rem;
            }

            .dashboard-card a.btn {
                background-color: #2C2E43;
                color: #FAF9F6;
                font-weight: 600;
                border: none;
                padding: 0.5rem 1rem;
                border-radius: 6px;
                transition: 0.2s;
                text-decoration: none;
            }

                .dashboard-card a.btn:hover {
                    background-color: #C7A86B;
                    color: #2C2E43;
                }
    </style>
</head>
<body>
    <div class="dashboard-header">
        <h1>Admin Dashboard</h1>
        <form method="post" action="/Admin/Logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="dashboard-container">
        <div class="dashboard-grid">
            <div class="dashboard-card">
                <h3>Add / Edit Book</h3>
                <p>Add new books or edit existing ones in your store.</p>
                <a href="/Admin/AddEditBook" class="btn">Go</a>
            </div>

            <div class="dashboard-card">
                <h3>Manage Categories</h3>
                <p>Create, edit, or remove categories for your books.</p>
                <a href="/Admin/ManageCategories" class="btn">Go</a>
            </div>

            <div class="dashboard-card">
                <h3>Manage Orders</h3>
                <p>View and update customer orders quickly.</p>
                <a href="/Admin/ManageOrders" class="btn">Go</a>
            </div>

            <div class="dashboard-card">
                <h3>Reports</h3>
                <p>Check sales, revenue, and performance reports.</p>
                <a href="/Admin/Reports" class="btn">Go</a>
            </div>

            <div class="dashboard-card">
                <h3>Settings</h3>
                <p>Update store preferences and settings.</p>
                <a href="/Admin/Settings" class="btn">Go</a>
            </div>
        </div>
    </div>
</body>
</html>
