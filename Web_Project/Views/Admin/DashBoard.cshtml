
@model dynamic

@{
    Layout = "_adminLayout";
}

<style>
    .dashboard-card {
        background-color: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        padding: 1.5rem;
        text-align: center;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .dashboard-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }

        .dashboard-card h3 {
            color: #1F2937;
            margin-bottom: 0.5rem;
            font-size: 2rem;
            font-weight: 600;
        }

        .dashboard-card p {
            color: #6B7280;
            margin-bottom: 1rem;
            font-size: 0.95rem;
        }

        .dashboard-card a {
            color: white;
            padding: 0.5rem 1rem;
            font-size: 0.9rem;
            background-color: #1F2937;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 500;
        }

            .dashboard-card a:hover {
                background-color: #6B4F4F;
            }
</style>

<h2 class="mb-4">Admin Dashboard</h2>
<p class="mb-4">Welcome back! Here's an overview of your store's activity.</p>

<div class="row g-4">
    <div class="col-lg-3 col-sm-6">
        <div class="dashboard-card">
            <h3>@(Model?.TotalBooks ?? "0")</h3>
            <p>Total Books</p>
            <a href="/Admin/ManageBooks">Manage Books</a>
        </div>
    </div>

    <div class="col-lg-3 col-sm-6">
        <div class="dashboard-card">
            <h3>@(Model?.TotalOrders ?? "0")</h3>
            <p>Total Orders</p>
            <a href="/Admin/ManageOrders">View Orders</a>
        </div>
    </div>

    <div class="col-lg-3 col-sm-6">
        <div class="dashboard-card">
            <h3>@(Model?.Delivered ?? "0")</h3>
            <p>Delivered Orders</p>
        </div>
    </div>
</div>
