
@{
    ViewData["Title"] = "Reports";
}

<h2>@ViewData["Title"]</h2>

<div class="reports-container">
    <div class="report-card">
        <h3>Total Orders</h3>
        <p>125</p>
    </div>
    <div class="report-card">
        <h3>Total Revenue (PKR)</h3>
        <p>1,250,000</p>
    </div>
    <div class="report-card">
        <h3>Total Customers</h3>
        <p>78</p>
    </div>
</div>

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: #E5DCC5;
        color: #2C2E43;
        padding: 2rem;
    }

    h2 {
        font-family: 'Cinzel', serif;
        margin-bottom: 1.5rem;
    }

    .reports-container {
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .report-card {
        flex: 1 1 200px;
        background: #FAF9F6;
        padding: 1.5rem;
        border-radius: 12px;
        box-shadow: 0 4px 8px rgba(44,46,67,0.1);
        text-align: center;
    }

        .report-card h3 {
            margin-bottom: 0.5rem;
            color: #2C2E43;
        }

        .report-card p {
            font-size: 1.5rem;
            font-weight: 600;
            color: #C7A86B;
        }
</style>
