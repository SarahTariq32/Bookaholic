@model List<Web_Project.Models.Category>

@{
    Layout = "_adminLayout";
}

<style>
    /* Page-specific styles (kept local) */
    .btn-blue {
        background-color: #1F2937;
        color: white;
        border-radius: 8px;
        font-weight: 500;
        transition: background-color 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .btn-blue:hover {
            background-color: #6B4F4F;
            color: white;
            box-shadow: 0px 2px 6px rgba(0,0,0,0.2);
        }

    .add-category-card, .categories-table-card {
        background-color: white;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .category-header {
        color: #1F2937;
        font-size: 1.75rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
    }
</style>

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Add New Category Card -->
<div class="add-category-card mb-4">
    <h2 class="category-header">Add New Category</h2>
    <form method="post" asp-action="AddCategory" class="d-flex" style="gap:.5rem; max-width:720px;">
        @Html.AntiForgeryToken()
        <input name="CategoryName" class="form-control" placeholder="Enter new category name..." required />
        <button type="submit" class="btn btn-blue">Add</button>
    </form>
</div>

<!-- Existing Categories Card -->
<div class="categories-table-card">
    <h2 class="category-header">Existing Categories</h2>
    <div class="table-responsive">
        <table class="table table-bordered mb-0">
            <thead>
                <tr>
                    <th style="width:80px">#</th>
                    <th>Category Name</th>
                    <th style="width:140px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var category in Model)
                    {
                        <tr>
                            <td class="align-middle">@category.CategoryID</td>
                            <td class="align-middle">@category.CategoryName</td>
                            <td class="align-middle">
                                <form method="post" asp-action="DeleteCategory" asp-route-id="@category.CategoryID" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">No categories found. Add new categories above.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
