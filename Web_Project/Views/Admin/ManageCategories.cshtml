@model List<Category>

<div class="container mt-5">
    <h2 class="mb-4" style="color:#ff4d79;">Manage Categories</h2>

    <form method="post" asp-action="AddCategory" class="mb-4">
        <div class="input-group">
            <input name="CategoryName" class="form-control" placeholder="New Category..." />
            <button class="btn btn-pink">Add</button>
        </div>
    </form>

    <div id="categoryTable">
        @await Html.PartialAsync("_CategoryTable", Model)
    </div>

</div>
