@model List<Order>

<table class="table table-dark table-hover">
    <thead>
        <tr><th>ID</th><th>Name</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.Id</td>
                <td>@o.CustomerName</td>
                <td>@o.Status</td>
                <td>
                    <a href="/Admin/OrderDetails/@o.Id" class="btn btn-sm btn-info">Details</a>
                    <a href="/Admin/DeleteOrder/@o.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
