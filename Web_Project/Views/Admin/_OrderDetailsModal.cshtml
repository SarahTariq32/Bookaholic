@model Web_Project.Models.ViewModels.OrderDetailsVM

<div class="modal fade" id="@($"detailsModal{Model.OrderId}")" tabindex="-1" aria-labelledby="detailsLabel@Model.OrderId" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Order #@Model.OrderId</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h6 class="mb-2">Customer</h6>
                        <p class="mb-1"><strong>Name:</strong> @Model.CustomerName</p>
                        <p class="mb-1"><strong>Email:</strong> @Model.CustomerEmail</p>
                        <p class="mb-1"><strong>Phone:</strong> @Model.CustomerPhone</p>

                        <h6 class="mt-3 mb-1">Address</h6>
                        <p class="small text-muted">@Html.Raw(System.Net.WebUtility.HtmlEncode(Model.Address).Replace("\n", "<br/>"))</p>
                    </div>

                    <div class="col-md-6">
                        <h6 class="mb-2">Order Info</h6>
                        <p class="mb-1"><strong>Status:</strong> @Model.Status</p>
                        <p class="mb-1"><strong>Order Date:</strong> @(Model.EstimatedDelivery.AddDays(-3).ToString("dd MMM yyyy"))</p>
                        <p class="mb-1"><strong>Payment:</strong> @Model.PaymentMethod</p>

                        <div class="mt-3">
                            <p class="mb-1"><strong class="fs-5">Total:</strong> <span class="fs-5">@Model.TotalAmount.ToString("C")</span></p>
                        </div>
                    </div>
                </div>

                <h6 class="mb-2">Items</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Book</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Line</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td style="min-width:220px;">@item.BookTitle</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">@item.Price.ToString("C")</td>
                                    <td class="text-end">@((item.Price * item.Quantity).ToString("C"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Okay</button>
            </div>
        </div>
    </div>
</div>