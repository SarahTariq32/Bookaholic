@* @model Web_Project.Models.ViewModels.OrderDetailsVM

<div class="modal fade" id="detailsModal@Model.OrderId" tabindex="-1" aria-labelledby="detailsLabel@Model.OrderId" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Order Details — #@Model.OrderId</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Customer:</strong> @Model.CustomerName</p>
                        <p class="mb-1"><strong>Email:</strong> @Model.CustomerEmail</p>
                        <p class="mb-1"><strong>Phone:</strong> @Model.CustomerPhone</p>
                        <p class="mb-1"><strong>Address:</strong> <span class="d-block">@Model.Address</span></p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Status:</strong> @Model.Status</p>
                        <p class="mb-1"><strong>Payment:</strong> @Model.PaymentMethod</p>
                        <p class="mb-1"><strong>Total:</strong> @Model.TotalAmount.ToString("C")</p>
                        <p class="mb-1"><strong>Shipping Fee:</strong> @Model.ShippingFee.ToString("C")</p>
                        <p class="mb-1"><strong>Est. Delivery:</strong> @Model.EstimatedDelivery.ToString("dd MMM yyyy")</p>
                    </div>
                </div>

                <h6 class="mt-3">Items</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Book</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Line Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td style="min-width:220px;">@item.BookTitle</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">@item.Price.ToString("C")</td>
                                    <td class="text-end">@((item.Price * item.Quantity).ToString("C"))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Subtotal</th>
                                <th class="text-end">@Model.Items.Sum(i => i.Price * i.Quantity).ToString("C")</th>
                            </tr>
                            <tr>
                                <th colspan="3" class="text-end">Shipping</th>
                                <th class="text-end">@Model.ShippingFee.ToString("C")</th>
                            </tr>
                            <tr>
                                <th colspan="3" class="text-end">Total</th>
                                <th class="text-end">@Model.TotalAmount.ToString("C")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

                @if (!string.Equals(Model.Status, "Delivered", StringComparison.OrdinalIgnoreCase))
                {
                    <form method="post" asp-action="MarkDelivered" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.OrderId" />
                        <button type="submit" class="btn btn-success">Mark Delivered</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div> *@


