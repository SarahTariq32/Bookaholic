@model List<Web_Project.Models.Order>
@using System.Linq

@{
    Layout = "_adminLayout";
}

@functions {
    private string GetBookTitle(int bookId)
    {
        var dict = ViewBag.BookTitles as IDictionary<int, string>;
        if (dict != null && dict.TryGetValue(bookId, out var title))
        {
            return title;
        }
        return "Unknown Book";
    }
}

<style>
    .orders-card {
        background-color: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.08);
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .section-header {
        cursor: pointer;
    }

    .td-wrap {
        white-space: normal;
        word-break: break-word;
        max-width: 240px;
    }

    .actions-inline > * {
        margin-right: .35rem;
        margin-bottom: .25rem;
    }

    #orderNotifications {
        position: fixed;
        top: 80px;
        right: 20px;
        width: 320px;
        z-index: 1200;
    }

    .empty-row td {
        padding: 1rem;
        text-align: center;
        color: #6c757d;
    }
</style>

<div id="orderNotifications" aria-live="polite" aria-atomic="true"></div>

<h2 class="mb-4">Manage Orders</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="orders-card">
    @{
        var pending = Model?
        .Where(o => !string.Equals(o.Status, "Delivered", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(o => o.OrderDate)
        .ToList() ?? new List<Web_Project.Models.Order>();

        var delivered = Model?
        .Where(o => string.Equals(o.Status, "Delivered", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(o => o.OrderDate)
        .ToList() ?? new List<Web_Project.Models.Order>();
    }

    <div class="mb-3">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center section-header" data-bs-toggle="collapse" data-bs-target="#pendingOrdersCollapse" aria-expanded="false" aria-controls="pendingOrdersCollapse">
                <div>
                    <strong>Pending Orders</strong>
                    <small id="pendingCount" class="text-muted">(@pending.Count)</small>
                </div>
                <button class="btn btn-link">Show</button>
            </div>

            <div id="pendingOrdersCollapse" class="collapse">
                <div class="card-body p-0">
                    @if (pending.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Customer</th>
                                        <th class="d-none d-sm-table-cell">Email</th>
                                        <th class="d-none d-sm-table-cell">Phone</th>
                                        <th>Address</th>
                                        <th class="d-none d-md-table-cell">Order Date</th>
                                        <th class="d-none d-md-table-cell">Total</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="pendingTbody">
                                    @foreach (var order in pending)
                                    {
                                        <tr data-order-id="@order.Id">
                                            <td class="align-middle">@order.Id</td>
                                            <td class="align-middle">@order.CustomerName</td>
                                            <td class="align-middle d-none d-sm-table-cell text-truncate" style="max-width:200px;">@order.CustomerEmail</td>
                                            <td class="align-middle d-none d-sm-table-cell">@order.CustomerPhone</td>
                                            <td class="align-middle td-wrap">@order.Address</td>
                                            <td class="align-middle d-none d-md-table-cell">@order.OrderDate.ToString("dd MMM yyyy")</td>
                                            <td class="align-middle d-none d-md-table-cell">@order.TotalAmount.ToString("C")</td>
                                            <td class="align-middle order-status">@order.Status</td>
                                            <td class="align-middle order-actions" style="white-space:nowrap;">
                                                <div class="actions-inline d-inline-flex flex-wrap align-items-center">
                                                    <button type="button" class="btn btn-primary btn-sm details-btn" data-order-id="@order.Id">Details</button>

                                                    <form method="post" asp-action="MarkDelivered" class="mark-delivered-form" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@order.Id" />
                                                        <button type="submit" class="btn btn-success btn-sm">Deliver</button>
                                                    </form>

                                                    <form method="post" asp-action="DeleteOrder" class="delete-order-form" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@order.Id" />
                                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div id="pendingEmptyMsg" class="p-3">No pending orders.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div>
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center section-header" data-bs-toggle="collapse" data-bs-target="#deliveredOrdersCollapse" aria-expanded="false" aria-controls="deliveredOrdersCollapse">
                <div>
                    <strong>Delivered Orders</strong>
                    <small id="deliveredCount" class="text-muted">(@delivered.Count)</small>
                </div>
                <button class="btn btn-link">Show</button>
            </div>

            <div id="deliveredOrdersCollapse" class="collapse">
                <div class="card-body p-0">
                    @if (delivered.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Customer</th>
                                        <th class="d-none d-sm-table-cell">Email</th>
                                        <th class="d-none d-sm-table-cell">Phone</th>
                                        <th>Address</th>
                                        <th class="d-none d-md-table-cell">Order Date</th>
                                        <th class="d-none d-md-table-cell">Total</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="deliveredTbody">
                                    @foreach (var order in delivered)
                                    {
                                        <tr data-order-id="@order.Id">
                                            <td class="align-middle">@order.Id</td>
                                            <td class="align-middle">@order.CustomerName</td>
                                            <td class="align-middle d-none d-sm-table-cell text-truncate" style="max-width:200px;">@order.CustomerEmail</td>
                                            <td class="align-middle d-none d-sm-table-cell">@order.CustomerPhone</td>
                                            <td class="align-middle td-wrap">@order.Address</td>
                                            <td class="align-middle d-none d-md-table-cell">@order.OrderDate.ToString("dd MMM yyyy")</td>
                                            <td class="align-middle d-none d-md-table-cell">@order.TotalAmount.ToString("C")</td>
                                            <td class="align-middle order-status">@order.Status</td>
                                            <td class="align-middle order-actions" style="white-space:nowrap;">
                                                <div class="actions-inline d-inline-flex flex-wrap align-items-center">
                                                    <button type="button" class="btn btn-primary btn-sm details-btn" data-order-id="@order.Id">Details</button>

                                                    <form method="post" asp-action="DeleteOrder" class="delete-order-form" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@order.Id" />
                                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div id="deliveredEmptyMsg" class="p-3">No delivered orders.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


<div id="order-modal-container"></div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js" crossorigin="anonymous"></script>

    <script>
        (function () {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/orderHub")
                .withAutomaticReconnect()
                .build();

            connection.on("NewOrder", function (data) {
                const container = document.getElementById("orderNotifications");
                if (!container) return;

                const id = "notif-" + Date.now();
                const div = document.createElement("div");
                div.id = id;
                div.className = "toast align-items-center text-bg-info border-0 show";
                div.setAttribute("role", "alert");
                div.setAttribute("aria-live", "assertive");
                div.setAttribute("aria-atomic", "true");
                div.innerHTML = `
                    <div class="d-flex">
                        <div class="toast-body">
                            New order <strong>#${data.orderId}</strong><br/>
                            ${data.customer} — PKR ${Number(data.total).toLocaleString()}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" aria-label="Close"></button>
                    </div>`;

                container.prepend(div);
                div.querySelector(".btn-close").addEventListener("click", () => div.remove());

                setTimeout(() => {
                    if (div.parentNode) div.parentNode.removeChild(div);
                }, 12000);
            });

            connection.start().catch(function (err) {
                console.error("SignalR connection error:", err.toString());
            });
        })();
    </script>

    <script>
        document.addEventListener('click', async function (ev) {
            const btn = ev.target.closest('.details-btn');
            if (!btn) return;

            const orderId = btn.getAttribute('data-order-id');
            if (!orderId) return;

            try {
                const url = `/Admin/OrderDetails?id=${encodeURIComponent(orderId)}`;
                const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!res.ok) {
                    console.error('Failed to load order details', res.status);
                    return;
                }
                const html = await res.text();

                const container = document.getElementById('order-modal-container');
                container.innerHTML = html;

                const modalEl = container.querySelector('.modal');
                if (!modalEl) {
                    console.warn('Returned partial does not contain a modal element.');
                    return;
                }
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            } catch (err) {
                console.error('Error loading order details', err);
            }
        }, false);
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const notifContainer = document.getElementById('orderNotifications');

            function showToast(message, type = 'info') {
                const id = 'toast-' + Date.now();
                const div = document.createElement('div');
                div.id = id;
                div.className = 'toast align-items-center text-bg-' + (type === 'success' ? 'success' : (type === 'danger' ? 'danger' : 'info')) + ' border-0 show';
                div.setAttribute('role', 'alert');
                div.setAttribute('aria-live', 'assertive');
                div.setAttribute('aria-atomic', 'true');
                div.innerHTML = `
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" aria-label="Close"></button>
                    </div>`;
                notifContainer.prepend(div);
                div.querySelector('.btn-close').addEventListener('click', () => div.remove());
                setTimeout(() => { if (div.parentNode) div.parentNode.removeChild(div); }, 8000);
            }

            function parseCountText(text) {

                const m = String(text).match(/\d+/);
                return m ? parseInt(m[0], 10) : 0;
            }

            function updateCountElements(pendingDelta, deliveredDelta) {
                const pendingElem = document.getElementById('pendingCount');
                const deliveredElem = document.getElementById('deliveredCount');

                if (pendingElem) {
                    const cur = parseCountText(pendingElem.textContent || pendingElem.innerText);
                    const next = Math.max(0, cur + pendingDelta);
                    pendingElem.textContent = `(${next})`;
                }
                if (deliveredElem) {
                    const cur = parseCountText(deliveredElem.textContent || deliveredElem.innerText);
                    const next = Math.max(0, cur + deliveredDelta);
                    deliveredElem.textContent = `(${next})`;
                }
            }

            function ensureDeliveredTable() {
                let tbody = document.getElementById('deliveredTbody');
                if (tbody) return tbody;

                const collapse = document.getElementById('deliveredOrdersCollapse');
                if (!collapse) return null;
                const cardBody = collapse.querySelector('.card-body');
                if (!cardBody) return null;

                cardBody.innerHTML = `
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Order ID</th>
                                    <th>Customer</th>
                                    <th class="d-none d-sm-table-cell">Email</th>
                                    <th class="d-none d-sm-table-cell">Phone</th>
                                    <th>Address</th>
                                    <th class="d-none d-md-table-cell">Order Date</th>
                                    <th class="d-none d-md-table-cell">Total</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="deliveredTbody"></tbody>
                        </table>
                    </div>`;
                return document.getElementById('deliveredTbody');
            }

            document.querySelectorAll('.mark-delivered-form').forEach(form => {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    const fd = new FormData(form);

                    try {
                        const res = await fetch(form.action || '/Admin/MarkDelivered', {
                            method: 'POST',
                            body: fd,
                            credentials: 'same-origin',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        if (!res.ok) throw new Error('Network error');

                        const json = await res.json();

                        if (json && json.success) {
                            showToast(json.message || 'Order is being delivered', 'success');

                            const tr = form.closest('tr');
                            if (tr) {
                                const orderId = json.orderId || tr.getAttribute('data-order-id') || fd.get('id');
                                tr.setAttribute('data-order-id', orderId);

                                const statusCell = tr.querySelector('.order-status');
                                if (statusCell) statusCell.textContent = 'Delivered';

                                const actions = tr.querySelector('.order-actions');
                                if (actions) {
                                    const deliverForm = actions.querySelector('.mark-delivered-form');
                                    if (deliverForm) deliverForm.remove();
                                }

                                const deliveredEmpty = document.getElementById('deliveredEmptyMsg');
                                if (deliveredEmpty) deliveredEmpty.remove();

                                const deliveredTbody = ensureDeliveredTable();
                                if (deliveredTbody) {

                                    deliveredTbody.prepend(tr);
                                } else {

                                    tr.remove();
                                }


                                updateCountElements(-1, +1);


                                const pendingTbody = document.getElementById('pendingTbody');
                                if (pendingTbody && pendingTbody.querySelectorAll('tr').length === 0) {
                                    const pendingCardBody = document.querySelector('#pendingOrdersCollapse .card-body');
                                    if (pendingCardBody) {
                                        pendingCardBody.innerHTML = `<div id="pendingEmptyMsg" class="p-3">No pending orders.</div>`;
                                    }
                                }
                            }
                        } else {
                            showToast((json && json.message) ? json.message : 'Failed to mark delivered', 'danger');
                        }
                    } catch (err) {
                        console.error('Deliver request failed', err);
                        showToast('Error marking order delivered', 'danger');
                    }
                });
            });

        });
    </script>
}
