@model Web_Project.Controllers.HomePageViewModel

@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
}

<div id="indexPage">

    <div id="mainSlider" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active"><img src="~/images/fantasy.PNG" alt="Fantasy"></div>
            <div class="carousel-item"><img src="~/images/romance.PNG" alt="Romance"></div>
            <div class="carousel-item"><img src="~/images/islam.PNG" alt="Islamic"></div>
            <div class="carousel-item"><img src="~/images/horror.PNG" alt="Horror"></div>
            <div class="carousel-item"><img src="~/images/children.PNG" alt="Children"></div>
            <div class="carousel-item"><img src="~/images/finance.PNG" alt="Finance"></div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#mainSlider" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#mainSlider" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>

    <section class="categories-section">
        <h2>Shop by Categories</h2>
        <hr />
        <div class="categories-container">
            <a asp-controller="Books" asp-action="BookList" asp-route-categoryId="1" class="category-card">
                <img src="~/images/fantasycat.JPG" /><p>Fantasy</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-categoryId="2" class="category-card">
                <img src="~/images/thrillercat.JPG" /><p>Thriller</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-categoryId="3" class="category-card">
                <img src="~/images/islamcat.JPG" /><p>Islamic</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-categoryId="4" class="category-card">
                <img src="~/images/horrorcat.JPG" /><p>Horror</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-categoryId="5" class="category-card">
                <img src="~/images/selfcat.JPG" /><p>Self Help</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-categoryId="6" class="category-card">
                <img src="~/images/urducat.JPG" /><p>Urdu</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-categoryId="7" class="category-card">
                <img src="~/images/romancecat.JPG" /><p>Romance</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-categoryId="8" class="category-card">
                <img src="~/images/mysterycat.JPG" /><p>Mystery</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-categoryId="9" class="category-card">
                <img src="~/images/leadcat.JPG" /><p>Leadership</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-categoryId="10" class="category-card">
                <img src="~/images/historycat.JPG" /><p>History</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-categoryId="11" class="category-card">
                <img src="~/images/biocat.JPG" /><p>Biography</p>
            </a>
        </div>
    </section>

    <section class="book-section">
        <h3>Fantasy Books</h3>
        <hr />
        <div class="books-container">
            @if (Model.BooksByCategory.ContainsKey("Fantasy"))
            {
                foreach (var book in Model.BooksByCategory["Fantasy"])
                {
                    <div class="book-card">
                        <img src="@book.CoverImage" alt="@book.Title">
                        <div class="book-info">
                            <p class="book-title">@book.Title</p>
                            <span class="book-price">PKR @book.Price</span>
                        </div>
                    </div>
                }
            }
        </div>
        <a asp-controller="Books" asp-action="BookList" asp-route-categoryId="1" class="see-more">See More</a>
    </section>

    <section class="book-section">
        <h3>Thriller Books</h3>
        <hr />
        <div class="books-container">
            @if (Model.BooksByCategory.ContainsKey("Thriller"))
            {
                foreach (var book in Model.BooksByCategory["Thriller"])
                {
                    <div class="book-card">
                        <img src="@book.CoverImage" alt="@book.Title">
                        <div class="book-info">
                            <p class="book-title">@book.Title</p>
                            <span class="book-price">PKR @book.Price</span>
                        </div>
                    </div>
                }
            }
        </div>
        <a asp-controller="Books" asp-action="BookList" asp-route-categoryId="2" class="see-more">See More</a>
    </section>

    <section class="book-section">
        <h3>Islamic Books</h3>
