@section Scripts {
    <script>
        // adjust slider height
        function updateSliderHeight() {
            var nav = document.querySelector('.navbar') || document.querySelector('nav');
            var navHeight = nav ? Math.ceil(nav.getBoundingClientRect().height) : 70;
            document.documentElement.style.setProperty('--slider-height', (window.innerHeight - navHeight) + 'px');
        }
        window.addEventListener('load', updateSliderHeight);
        window.addEventListener('resize', updateSliderHeight);

        // simple horizontal scroll by card width
        (function () {
            var container = document.querySelector('.categories-container');
            var scrollAmount = 360; // adjust as desired
            if (!container) return;
            // allow wheel to scroll horizontally on desktop
            container.addEventListener('wheel', function (e) {
                if (Math.abs(e.deltaX) < Math.abs(e.deltaY)) {
                    e.preventDefault();
                    container.scrollBy({ left: e.deltaY, behavior: 'smooth' });
                }
            }, { passive: false });
        })();
    </script>
}