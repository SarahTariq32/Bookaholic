@model Web_Project.Controllers.HomePageViewModel

@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
    <style>
        :root {
            --slider-height: calc(100vh - 70px);
        }

        /* slider */
        #mainSlider {
            width: 100%;
            overflow: hidden;
        }

            #mainSlider .carousel-inner,
            #mainSlider .carousel-item {
                height: var(--slider-height);
            }

                #mainSlider .carousel-item img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                    border-top-left-radius: 0;
                    border-top-right-radius: 0;
                }

        /* categories horizontal */
        .categories-section {
            margin: 1.5rem 0;
            position: relative;
        }

        .categories-container {
            display: flex;
            gap: 1rem;
            overflow-x: auto;
            padding: 0.75rem 0;
            -webkit-overflow-scrolling: touch;
            scroll-behavior: smooth;
            scroll-snap-type: x mandatory;
        }

            .categories-container::-webkit-scrollbar {
                height: 8px;
            }

            .categories-container::-webkit-scrollbar-thumb {
                background: rgba(0,0,0,0.12);
                border-radius: 4px;
            }

        .category-card {
            scroll-snap-align: start;
            flex: 0 0 180px;
            min-width: 180px;
            background: #fff;
            border-radius: 8px;
            overflow: hidden;
            text-align: center;
            box-shadow: 0 6px 18px rgba(0,0,0,0.06);
            text-decoration: none;
            color: inherit;
        }

            .category-card img {
                width: 100%;
                height: 110px;
                object-fit: cover;
                display: block;
            }

            .category-card p {
                margin: 0.5rem 0 0;
                font-weight: 600;
            }

        /* book grid */
        .book-section {
            margin: 2rem 0;
        }

        .books-container {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(180px,1fr));
            gap: 1rem;
            align-items: start;
        }

        .book-card {
            background: #fff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 6px 18px rgba(0,0,0,0.06);
            display: block;
            color: inherit;
            text-decoration: none;
        }

            .book-card img {
                width: 100%;
                height: 220px;
                object-fit: cover;
                display: block;
            }

        .book-info {
            padding: 0.6rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.5rem;
        }

        .book-title {
            margin: 0;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .book-price {
            color: #c7a86b;
            font-weight: 700;
        }

        .see-more {
            display: inline-block;
            margin-top: 0.75rem;
            color: #1f2937;
            text-decoration: none;
            font-weight: 600;
        }
    </style>
}

 <div id="indexPage"> 

    <!-- Main slider -->
    <div id="mainSlider" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active"><img src="~/images/fantasy.PNG" alt="Fantasy"></div>
            <div class="carousel-item"><img src="~/images/romance.PNG" alt="Romance"></div>          
            <div class="carousel-item"><img src="~/images/Horror.PNG" alt="Horror"></div>   
            <div class="carousel-item"><img src="~/images/Thriller.PNG" alt="Thriller"></div>
            <div class="carousel-item"><img src="~/images/Urdu.PNG" alt="Urdu"></div>
            <div class="carousel-item"><img src="~/images/islam.PNG" alt="Islamic"></div>
            <div class="carousel-item"><img src="~/images/Children.PNG" alt="Children"></div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#mainSlider" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#mainSlider" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Next</span>
        </button>
    </div>

    <!-- Categories (horizontal) - link by category NAME to BooksController.Index -->
    <section class="categories-section">
        <h2>Shop by Categories</h2>
        <hr />
        <div class="categories-container" role="list">
            <a asp-controller="Books" asp-action="BookList" asp-route-category="Fantasy" class="category-card" role="listitem">
                <img src="~/images/fantasycat.JPG" alt="Fantasy" /><p>Fantasy</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-category="Thriller" class="category-card" role="listitem">
                <img src="~/images/thrillercat.JPG" alt="Thriller" /><p>Thriller</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-category="Islamic" class="category-card" role="listitem">
                <img src="~/images/islamcat.JPG" alt="Islamic" /><p>Islamic</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-category="Horror" class="category-card" role="listitem">
                <img src="~/images/horrorcat.JPG" alt="Horror" /><p>Horror</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-category="Self-Help" class="category-card" role="listitem">
                <img src="~/images/selfcat.JPG" alt="Self Help" /><p>Self Help</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-category="Urdu" class="category-card" role="listitem">
                <img src="~/images/urducat.JPG" alt="Urdu" /><p>Urdu</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-category="Romance" class="category-card" role="listitem">
                <img src="~/images/romancecat.JPG" alt="Romance" /><p>Romance</p>
            </a>
            <a asp-controller="Books" asp-action="BookList" asp-route-category="History" class="category-card" role="listitem">
                <img src="~/images/historycat.JPG" alt="History" /><p>History</p>
            </a>
            
        </div>
    </section>

    <!-- Book sections: each book card links to BooksController.Details?id=... -->
    <section class="book-section">
        <h3>Fantasy Books</h3>
        <hr />
        <div class="books-container">
            @if (Model?.BooksByCategory != null && Model.BooksByCategory.ContainsKey("Fantasy"))
            {
                foreach (var book in Model.BooksByCategory["Fantasy"])
                {
                    <a asp-controller="Books" asp-action="BookDetails" asp-route-id="@book.BookID" class="book-card">
                        <img src="@book.CoverImage" alt="@book.Title" />
                        <div class="book-info">
                            <p class="book-title">@book.Title</p>
                            <span class="book-price">PKR @book.Price</span>
                        </div>
                    </a>
                }
            }
        </div>
        <a asp-controller="Books" asp-action="BookList" asp-route-category="Fantasy" class="see-more">See More</a>
    </section>

    <section class="book-section">
        <h3>Thriller Books</h3>
        <hr />
        <div class="books-container">
            @if (Model?.BooksByCategory != null && Model.BooksByCategory.ContainsKey("Thriller"))
            {
                foreach (var book in Model.BooksByCategory["Thriller"])
                {
                    <a asp-controller="Books" asp-action="BookDetails" asp-route-id="@book.BookID" class="book-card">
                        <img src="@book.CoverImage" alt="@book.Title" />
                        <div class="book-info">
                            <p class="book-title">@book.Title</p>
                            <span class="book-price">PKR @book.Price</span>
                        </div>
                    </a>
                }
            }
        </div>
        <a asp-controller="Books" asp-action="BookList" asp-route-category="Thriller" class="see-more">See More</a>
    </section>

    <section class="book-section">
        <h3>Islamic Books</h3>
        <hr />
        <div class="books-container">
            @if (Model?.BooksByCategory != null && Model.BooksByCategory.ContainsKey("Islamic"))
            {
                foreach (var book in Model.BooksByCategory["Islamic"])
                {
                    <a asp-controller="Books" asp-action="BookDetails" asp-route-id="@book.BookID" class="book-card">
                        <img src="@book.CoverImage" alt="@book.Title" />
                        <div class="book-info">
                            <p class="book-title">@book.Title</p>
                            <span class="book-price">PKR @book.Price</span>
                        </div>
                    </a>
                }
            }
        </div>
        <a asp-controller="Books" asp-action="BookList" asp-route-category="Islamic" class="see-more">See More</a>
    </section>

    <section class="book-section">
        <h3>Horror Books</h3>
        <hr />
        <div class="books-container">
            @if (Model?.BooksByCategory != null && Model.BooksByCategory.ContainsKey("Horror"))
            {
                foreach (var book in Model.BooksByCategory["Horror"])
                {
                    <a asp-controller="Books" asp-action="BookDetails" asp-route-id="@book.BookID" class="book-card">
                        <img src="@book.CoverImage" alt="@book.Title" />
                        <div class="book-info">
                            <p class="book-title">@book.Title</p>
                            <span class="book-price">PKR @book.Price</span>
                        </div>
                                                                    
                    </a>
                }
            }
        </div>
        <a asp-controller="Books" asp-action="BookList" asp-route-category="Horror" class="see-more">See More</a>
    </section>

 </div> 

@section Scripts {
    <script>
        function updateSliderHeight() {
            var nav = document.querySelector('.navbar') || document.querySelector('nav');
            var navHeight = nav ? Math.ceil(nav.getBoundingClientRect().height) : 70;
            document.documentElement.style.setProperty('--slider-height', (window.innerHeight - navHeight) + 'px');
        }
        window.addEventListener('load', updateSliderHeight);
        window.addEventListener('resize', updateSliderHeight);

        (function () {
            var container = document.querySelector('.categories-container');
            var scrollAmount = 360; 
            if (!container) return;

            container.addEventListener('wheel', function (e) {
                if (Math.abs(e.deltaX) < Math.abs(e.deltaY)) {
                    e.preventDefault();
                    container.scrollBy({ left: e.deltaY, behavior: 'smooth' });
                }
            }, { passive: false });
        })();
    </script>
}