@section Scripts {
    <script>
        // compute slider height to fill viewport under navbar
        function updateSliderHeight() {
            var nav = document.querySelector('.navbar') || document.querySelector('nav');
            var navHeight = nav ? Math.ceil(nav.getBoundingClientRect().height) : 70;
            var vh = window.innerHeight;
            document.documentElement.style.setProperty('--slider-height', (vh - navHeight) + 'px');
        }
        window.addEventListener('load', updateSliderHeight);
        window.addEventListener('resize', updateSliderHeight);

        // category scroll controls
        (function () {
            var container = document.getElementById('categoriesContainer');
            var prev = document.getElementById('catPrev');
            var next = document.getElementById('catNext');
            if (!container) return;

            function scrollByAmount(amount) {
                container.scrollBy({ left: amount, behavior: 'smooth' });
            }

            prev?.addEventListener('click', function () {
                scrollByAmount(-Math.round(container.clientWidth * 0.7));
            });
            next?.addEventListener('click', function () {
                scrollByAmount(Math.round(container.clientWidth * 0.7));
            });
        })();
    </script>
} *@

