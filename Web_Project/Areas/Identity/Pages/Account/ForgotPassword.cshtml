@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot your password?";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Bookaholic</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: url('/images/fantasy.PNG') no-repeat center center fixed;
            background-size: cover;
            font-family: "Inter", sans-serif;
            margin: 0;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            body::before {
                content: "";
                position: fixed;
                inset: 0;
                background: rgba(10, 20, 35, 0.55);
                backdrop-filter: blur(3px);
                z-index: 0;
            }

        .auth-card {
            position: relative;
            z-index: 1;
            width: 420px;
            background: rgba(23, 35, 55, 0.65);
            border: 1px solid rgba(255, 240, 225, 0.25);
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 0 25px rgba(0,0,0,0.25);
        }

        .auth-title {
            font-family: "Merriweather", serif;
            font-size: 1.8rem;
            font-weight: 600;
            color: #e8dbc8;
            text-align: center;
            margin-bottom: 1rem;
        }

        .auth-subtitle {
            font-size: 1.1rem;
            color: #f5f2ee;
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .form-label {
            color: #e5dfd6 !important;
        }

        .form-control {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,240,225,0.2);
            color: #f5f2ee;
        }

            .form-control::placeholder {
                color: #f5f2ee !important;
                opacity: 0.8;
            }

            .form-control:focus {
                background: rgba(255,255,255,0.12);
                border-color: #e8dbc8;
                box-shadow: 0 0 0 .25rem rgba(232, 219, 200, 0.28);
                color: #FAF9F6 !important;
            }

        button[type="submit"] {
            background: #e8dbc8;
            color: #182331;
            font-weight: 600;
            border: none;
            margin-top: 10px;
        }

            button[type="submit"]:hover {
                background: #d5c8b6;
            }

        .text-danger {
            color: #ffb3b3 !important;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <h1 class="auth-title">Forgot Password?</h1>
        <p class="auth-subtitle">Enter your email to reset your password</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="you@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg">Reset Password</button>
        </form>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
