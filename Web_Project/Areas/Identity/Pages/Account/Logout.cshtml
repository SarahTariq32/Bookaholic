@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Bookaholic</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: url('/images/fantasy.png') no-repeat center center fixed;
            background-size: cover;
            font-family: "Inter", sans-serif;
            margin: 0;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            body::before {
                content: "";
                position: fixed;
                inset: 0;
                background: rgba(10, 20, 35, 0.55);
                backdrop-filter: blur(3px);
                z-index: 0;
            }

        .auth-card {
            position: relative;
            z-index: 1;
            width: 420px;
            background: rgba(23, 35, 55, 0.65);
            border: 1px solid rgba(255, 240, 225, 0.25);
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 0 25px rgba(0,0,0,0.25);
            text-align: center;
        }

        .auth-title {
            font-family: "Merriweather", serif;
            font-size: 1.8rem;
            font-weight: 600;
            color: #e8dbc8;
            margin-bottom: 1.5rem;
        }

        .logout-message {
            color: #f5f2ee;
            margin-bottom: 1.5rem;
            font-size: 1.1rem;
        }

        button[type="submit"] {
            background: #e8dbc8;
            color: #182331;
            font-weight: 600;
            border: none;
            padding: 0.5rem 1rem;
        }

            button[type="submit"]:hover {
                background: #d5c8b6;
            }
    </style>
</head>
<body>
    <div class="auth-card">
        <h1 class="auth-title">Logout</h1>

        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <p class="logout-message">Click the button below to log out of your account.</p>
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit">Log Out</button>
            </form>
        }
        else
        {
            <p class="logout-message">You have successfully logged out of the application.</p>
            <a href="/Identity/Account/Login" class="btn" style="background:#e8dbc8; color:#182331; font-weight:600;">Log In Again</a>
        }
    </div>
</body>
</html>
